<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Confirmation de votre réservation d'excursion</title>
</head>
<body style="margin:0;padding:0;background:#f3f6fb;font-family:Arial,Helvetica,sans-serif;color:#26344d;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f3f6fb;padding:28px 12px;">
    <tr><td align="center">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e4e9f1;border-radius:14px;overflow:hidden;">
            <tr><td style="padding:24px 28px;background:#1748b5;color:#ffffff;font-size:20px;font-weight:bold;">{{ siteName }}</td></tr>
            <tr><td style="padding:28px;">
                <h1 style="margin:0 0 18px;font-size:22px;color:#18243a;">Votre réservation d'excursion est confirmée</h1>
                <p style="margin:0 0 16px;line-height:1.65;">Bonjour{% if clientName %} {{ clientName }}{% endif %},</p>
                <p style="margin:0 0 22px;line-height:1.65;">Nous avons le plaisir de vous informer que votre réservation pour l’excursion <strong>« {{ excursionTitle }} »</strong> a été acceptée et confirmée par notre équipe.</p>

                <h2 style="margin:0 0 12px;font-size:16px;color:#26344d;">Récapitulatif de votre réservation</h2>
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;border:1px solid #e4e9f1;">
                    {% if reservation.id %}
                        <tr><td style="padding:10px;border-bottom:1px solid #e4e9f1;color:#68758b;">Référence</td><td style="padding:10px;border-bottom:1px solid #e4e9f1;font-weight:bold;">#{{ reservation.id }}</td></tr>
                    {% endif %}
                    <tr><td style="padding:10px;border-bottom:1px solid #e4e9f1;color:#68758b;">Excursion</td><td style="padding:10px;border-bottom:1px solid #e4e9f1;font-weight:bold;">{{ excursionTitle }}</td></tr>
                    <tr><td style="padding:10px;border-bottom:1px solid #e4e9f1;color:#68758b;">Date de l'excursion</td><td style="padding:10px;border-bottom:1px solid #e4e9f1;">{{ reservation.dateExcursion ? reservation.dateExcursion|date('d/m/Y') : '' }}</td></tr>
                    <tr><td style="padding:10px;border-bottom:1px solid #e4e9f1;color:#68758b;">Heure de départ</td><td style="padding:10px;border-bottom:1px solid #e4e9f1;">{{ reservation.heureDepart ? reservation.heureDepart|date('H:i') : '' }}</td></tr>
                    <tr><td style="padding:10px;border-bottom:1px solid #e4e9f1;color:#68758b;">Participants</td><td style="padding:10px;border-bottom:1px solid #e4e9f1;">{{ reservation.nombreAdultes }} adulte{{ reservation.nombreAdultes > 1 ? 's' : '' }}{% if reservation.nombreEnfants > 0 %}, {{ reservation.nombreEnfants }} enfant{{ reservation.nombreEnfants > 1 ? 's' : '' }}{% endif %}</td></tr>
                    <tr><td style="padding:10px;border-bottom:1px solid #e4e9f1;color:#68758b;">Prise en charge</td><td style="padding:10px;border-bottom:1px solid #e4e9f1;">{{ reservation.lieuPriseEnCharge }}</td></tr>
                    <tr><td style="padding:10px;border-bottom:1px solid #e4e9f1;color:#68758b;">WhatsApp</td><td style="padding:10px;border-bottom:1px solid #e4e9f1;">{{ reservation.whatsapp }}</td></tr>
                </table>

                <p style="margin:22px 0 0;line-height:1.65;">Merci pour votre confiance. Notre équipe vous contactera si nécessaire avant le départ.</p>
                <p style="margin:20px 0 0;line-height:1.65;">Cordialement,<br><strong>L’équipe {{ siteName }}</strong></p>
            </td></tr>
        </table>
    </td></tr>
</table>
</body>
</html>
