{% extends 'baseFront.html.twig' %}

{% block title %}{{ 'contact.page_title'|trans }} - Yassmine Guide{% endblock %}

{% block meta_description %}<meta name="description" content="{{ 'contact.hero.subtitle'|trans|striptags|trim }}">{% endblock %}

{% block stylesheets %}
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="{{ asset('assetsFront/js/tailwind.config.js') }}"></script>
{% endblock %}

{% block body_class %}bg-surface text-on-surface antialiased{% endblock %}

{% block body %}
{% include 'Frontend/Components/_navbar.html.twig' %}

<main class="w-full pt-20 bg-surface">
    {% for message in app.flashes('success') %}
    <div class="max-w-[1280px] mx-auto px-4 md:px-8 xl:px-12 pt-4">
        <div class="rounded-xl bg-tertiary/10 px-4 py-3 text-sm font-semibold text-tertiary">{{ message|trans }}</div>
    </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
    <div class="max-w-[1280px] mx-auto px-4 md:px-8 xl:px-12 pt-4">
        <div class="rounded-xl bg-error/10 px-4 py-3 text-sm font-semibold text-error">{{ message|trans }}</div>
    </div>
    {% endfor %}

    {# Hero Section #}
    <div class="relative w-full overflow-hidden bg-gradient-to-b from-surface-container-high/60 via-surface to-background pb-12 pt-8">
        <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
        <div class="absolute left-1/4 -bottom-24 h-80 w-80 rounded-full bg-secondary-container/20 blur-2xl pointer-events-none"></div>
        <div class="max-w-[1280px] mx-auto px-4 md:px-8 xl:px-12 w-full relative z-10">
            <nav aria-label="Fil d'Ariane" class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant mb-4">
                <a class="hover:text-primary transition-colors flex items-center gap-1" href="{{ path('app_home_locale', {'_locale': locale}) }}">
                    <span class="material-symbols-outlined text-base">home</span>
                    <span>{{ 'contact.breadcrumb_home'|trans }}</span>
                </a>
                <span class="material-symbols-outlined text-sm opacity-40">chevron_right</span>
                <span class="text-primary font-semibold">{{ 'contact.breadcrumb_contact'|trans }}</span>
            </nav>
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
                <div class="max-w-3xl">
                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-subheading text-subheading mb-3 uppercase tracking-wider">
                        <span class="material-symbols-outlined text-sm text-primary">headset_mic</span>
                        <span>{{ 'contact.hero.badge'|trans }}</span>
                    </div>
                    <h1 class="font-display text-display text-on-surface tracking-tight mb-3">
                        {{ 'contact.hero.title'|trans }}
                    </h1>
                    <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
                        {{ 'contact.hero.subtitle'|trans }}
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row items-start lg:items-center gap-3 shrink-0">
                    <div class="flex items-center gap-2 bg-surface-container-lowest px-4 py-2.5 rounded-full shadow-sm">
                        <span class="relative flex h-3 w-3">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-3 w-3 bg-primary"></span>
                        </span>
                        <span class="font-label-sm text-label-sm text-on-surface font-medium">{{ 'contact.hero.response_time'|trans }}</span>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-6 pt-2">
                <div class="flex items-center gap-3 bg-surface-container-lowest/80 backdrop-blur-sm p-3 rounded-xl shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">speed</span>
                    </div>
                    <div>
                        <p class="font-label-md text-label-md font-semibold text-on-surface">{{ 'contact.hero.feature1_title'|trans }}</p>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">{{ 'contact.hero.feature1_desc'|trans }}</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 bg-surface-container-lowest/80 backdrop-blur-sm p-3 rounded-xl shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-secondary/10 text-secondary flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">support_agent</span>
                    </div>
                    <div>
                        <p class="font-label-md text-label-md font-semibold text-on-surface">{{ 'contact.hero.feature2_title'|trans }}</p>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">{{ 'contact.hero.feature2_desc'|trans }}</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 bg-surface-container-lowest/80 backdrop-blur-sm p-3 rounded-xl shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-primary-container/10 text-primary-container flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">flight_takeoff</span>
                    </div>
                    <div>
                        <p class="font-label-md text-label-md font-semibold text-on-surface">{{ 'contact.hero.feature3_title'|trans }}</p>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">{{ 'contact.hero.feature3_desc'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Main Contact Section #}
    <section class="max-w-[1280px] mx-auto px-4 md:px-8 xl:px-12 w-full py-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-7 flex flex-col">
                <div class="bg-surface-container-lowest p-6 sm:p-8 rounded-2xl shadow-md">
                    <div class="mb-4">
                        <span class="font-subheading text-subheading text-primary uppercase font-bold tracking-wider">{{ 'contact.form.badge'|trans }}</span>
                        <h2 class="font-headline-md text-headline-md text-on-surface mt-1">{{ 'contact.form.title'|trans }}</h2>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">{{ 'contact.form.subtitle'|trans }}</p>
                    </div>
                   
                    
                    {{ form_start(contactForm, {attr: {class: 'space-y-4', id: 'contactForm'}}) }}
                    {{ form_errors(contactForm) }}

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                            {{ form_label(contactForm.firstName, null, {'label_attr': {'class': 'font-label-md text-label-md font-semibold text-on-surface'}}) }}
                            {{ form_widget(contactForm.firstName) }}
                            {{ form_errors(contactForm.firstName) }}
                        </div>
                        <div class="flex flex-col gap-1.5">
                            {{ form_label(contactForm.lastName, null, {'label_attr': {'class': 'font-label-md text-label-md font-semibold text-on-surface'}}) }}
                            {{ form_widget(contactForm.lastName) }}
                            {{ form_errors(contactForm.lastName) }}
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                            {{ form_label(contactForm.email, null, {'label_attr': {'class': 'font-label-md text-label-md font-semibold text-on-surface'}}) }}
                            {{ form_widget(contactForm.email) }}
                            {{ form_errors(contactForm.email) }}
                        </div>
                        <div class="flex flex-col gap-1.5">
                            {{ form_label(contactForm.phone, null, {'label_attr': {'class': 'font-label-md text-label-md font-semibold text-on-surface'}}) }}
                            <div class="flex gap-2">
                                <div class="w-28 shrink-0 flex items-center justify-between px-3 h-12 rounded-xl bg-surface-container-low text-on-surface font-label-md text-label-md">
                                    <span>🇹🇳 +216</span>
                                    <span class="material-symbols-outlined text-xs text-outline">expand_more</span>
                                </div>
                                {{ form_widget(contactForm.phone) }}
                            </div>
                            {{ form_errors(contactForm.phone) }}
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                            {{ form_label(contactForm.requestType, null, {'label_attr': {'class': 'font-label-md text-label-md font-semibold text-on-surface'}}) }}
                            <div class="relative">
                                {{ form_widget(contactForm.requestType) }}
                                <span class="material-symbols-outlined absolute right-3 top-3.5 pointer-events-none text-outline">expand_more</span>
                            </div>
                            {{ form_errors(contactForm.requestType) }}
                        </div>
                        <div class="flex flex-col gap-1.5">
                            {{ form_label(contactForm.serviceCategory, null, {'label_attr': {'class': 'font-label-md text-label-md font-semibold text-on-surface'}}) }}
                            <div class="relative">
                                {{ form_widget(contactForm.serviceCategory) }}
                                <span class="material-symbols-outlined absolute right-3 top-3.5 pointer-events-none text-outline">expand_more</span>
                            </div>
                            {{ form_errors(contactForm.serviceCategory) }}
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <div class="flex items-center justify-between">
                            {{ form_label(contactForm.reservationNumber, null, {'label_attr': {'class': 'font-label-md text-label-md font-semibold text-on-surface'}}) }}
                            <span class="text-outline font-normal text-xs font-label-sm">{{ 'contact.form.reservation_optional'|trans }}</span>
                        </div>
                        {{ form_widget(contactForm.reservationNumber) }}
                        {{ form_errors(contactForm.reservationNumber) }}
                    </div>

                    <div class="flex flex-col gap-1.5">
                        {{ form_label(contactForm.subject, null, {'label_attr': {'class': 'font-label-md text-label-md font-semibold text-on-surface'}}) }}
                        {{ form_widget(contactForm.subject) }}
                        {{ form_errors(contactForm.subject) }}
                    </div>

                    <div class="flex flex-col gap-1.5">
                        {{ form_label(contactForm.message, null, {'label_attr': {'class': 'font-label-md text-label-md font-semibold text-on-surface'}}) }}
                        {{ form_widget(contactForm.message) }}
                        {{ form_errors(contactForm.message) }}
                    </div>

                    <div class="pt-2">
                        <label class="flex items-start gap-3 cursor-pointer group">
                            <input checked class="mt-1 h-4 w-4 rounded text-primary focus:ring-primary bg-surface-container-low cursor-pointer" type="checkbox"/>
                            <span class="font-body-sm text-body-sm text-on-surface-variant group-hover:text-on-surface transition-colors">
                                {{ 'contact.form.whatsapp_consent'|trans }}
                            </span>
                        </label>
                    </div>

                    <div class="pt-3 flex flex-col gap-3">
                        <button type="submit" class="w-full h-14 rounded-full bg-gradient-to-r from-primary-container to-on-secondary-fixed text-on-primary font-label-md text-label-md font-semibold flex items-center justify-center gap-2 shadow-md hover:shadow-lg hover:brightness-105 active:scale-[0.99] transition-all">
                            <span class="material-symbols-outlined text-xl">send</span>
                            <span>{{ 'contact.form.submit'|trans }}</span>
                        </button>
                        <div class="flex items-center justify-center gap-2 text-center text-outline font-label-sm text-label-sm">
                            <span class="material-symbols-outlined text-sm text-primary">lock</span>
                            <span>{{ 'contact.form.security_note'|trans }}</span>
                        </div>
                    </div>

                    {{ form_end(contactForm) }}
                </div>
            </div>

            <div class="lg:col-span-5 flex flex-col gap-6">
                <div class="bg-gradient-to-br from-[#063B73] via-[#0B5ED7] to-[#063B73] rounded-2xl p-6 text-on-primary shadow-xl relative overflow-hidden">
                    <div class="absolute -right-8 -bottom-8 w-44 h-44 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
                    <div class="flex items-center justify-between mb-4 relative z-10">
                        <span class="px-3 py-1 rounded-full bg-white/20 text-white font-label-sm text-label-sm uppercase tracking-wider font-semibold backdrop-blur-sm flex items-center gap-1.5">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
                            </span>
                            {{ 'contact.urgent.badge'|trans }}
                        </span>
                        <span class="material-symbols-outlined text-3xl opacity-80">support</span>
                    </div>
                    <h3 class="font-headline-sm text-headline-sm text-white mb-2 relative z-10">
                        {{ 'contact.urgent.title'|trans }}
                    </h3>
                    <p class="font-body-md text-body-md text-on-primary-container leading-relaxed mb-6 relative z-10">
                        {{ 'contact.urgent.subtitle'|trans }}
                    </p>
                    <div class="space-y-3 relative z-10">
                        {# Téléphone / WhatsApp : le clic ouvre la conversation WhatsApp #}
                        <a class="flex items-center justify-between p-3 rounded-xl bg-white text-on-secondary-fixed shadow-md hover:bg-surface-container-lowest transition-all group" href="https://wa.me/21624651548" rel="noopener noreferrer" target="_blank">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-[#25D366]/20 text-[#075E54] flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                                    <span class="material-symbols-outlined text-2xl font-bold">chat</span>
                                </div>
                                <div class="min-w-0">
                                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">{{ 'contact.urgent.phone_label'|trans }}</p>
                                    <p class="font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight">+216 24 651 548</p>
                                </div>
                            </div>
                            <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">open_in_new</span>
                        </a>
                        {# E-mail : le clic ouvre le logiciel de messagerie #}
                        <a class="flex items-center justify-between p-3 rounded-xl bg-white/10 hover:bg-white/20 transition-all group backdrop-blur-sm" href="mailto:yassmineGuide@gmail.com">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0 group-hover:scale-105 transition-transform">
                                    <span class="material-symbols-outlined">mail</span>
                                </div>
                                <div class="min-w-0">
                                    <p class="font-label-sm text-label-sm text-white/80 uppercase tracking-wider">{{ 'contact.urgent.email_label'|trans }}</p>
                                    <p class="font-headline-sm text-headline-sm text-white font-bold tracking-tight truncate">yassmineGuide@gmail.com</p>
                                </div>
                            </div>
                            <span class="material-symbols-outlined text-white/70 group-hover:translate-x-1 transition-transform">arrow_forward</span>
                        </a>
                        {# Disponibilité : Assistance 24/7 #}
                        <div class="flex items-center gap-3 p-3 rounded-xl bg-white/10 backdrop-blur-sm">
                            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0">
                                <span class="material-symbols-outlined">support_agent</span>
                            </div>
                            <div class="min-w-0">
                                <p class="font-label-sm text-label-sm text-white/80 uppercase tracking-wider">{{ 'contact.urgent.availability_label'|trans }}</p>
                                <p class="font-headline-sm text-headline-sm text-white font-bold tracking-tight">{{ 'contact.urgent.availability_value'|trans }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-6 shadow-sm flex items-center gap-4">
                    <div class="relative shrink-0">
                        <img alt="{{ 'contact.agent.name'|trans }}" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover shadow-sm" src="https://lh3.googleusercontent.com/aida/AEtjO1VifDzzm603PRgGeYq6letA5tS6FgHo4VDvDa7dYH0SRKrwGns6RI1JfB7PotiSUmjw5dN_z4MDyM4JIl6IdxdLO_mESWU2jcxMIvnMXzZVKd9At0aOzvZyD7xfRq0xe49WjO5pAHa-GV4eGA58b-MOb0M7Q8ir6_PzC91SkCuVrvuSVeBsgHErt4NfF1_Gt1ssfuzcAtw5e-6srwctZZufHYWOPy0-ZpCOTd0HlUhsPddktkY7mBhLEF0"/>
                        <span class="absolute -bottom-1.5 -right-1.5 w-6 h-6 rounded-full bg-primary flex items-center justify-center text-white shadow-sm" title="{{ 'contact.agent.verified_title'|trans }}">
                            <span class="material-symbols-outlined text-xs">verified</span>
                        </span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <div class="inline-flex items-center gap-1.5 self-start px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-semibold mb-1">
                            {{ 'contact.agent.role'|trans }}
                        </div>
                        <h4 class="font-headline-sm text-headline-sm text-on-surface truncate">{{ 'contact.agent.name'|trans }}</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-0.5">
                            {{ 'contact.agent.quote'|trans }}
                        </p>
                    </div>
                </div>

                <div class="bg-surface-container-low rounded-2xl p-4 flex items-start gap-3">
                    <div class="w-9 h-9 rounded-full bg-primary-container text-on-primary flex items-center justify-center shrink-0 mt-0.5">
                        <span class="material-symbols-outlined text-lg">badge</span>
                    </div>
                    <div>
                        <h5 class="font-label-md text-label-md font-bold text-on-surface">{{ 'contact.vip.title'|trans }}</h5>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
                            {{ 'contact.vip.desc'|trans }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
</main>

{% include 'Frontend/Components/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
<script src="{{ asset('assetsFront/js/navbar.js') }}?v=3"></script>
<script>
    document.querySelectorAll('.tab-pill').forEach(pill => {
        pill.addEventListener('click', () => {
            document.querySelectorAll('.tab-pill').forEach(btn => {
                btn.classList.remove('bg-primary-container', 'text-on-primary', 'font-semibold', 'shadow-sm');
                btn.classList.add('text-on-surface-variant', 'font-medium');
            });
            pill.classList.add('bg-primary-container', 'text-on-primary', 'font-semibold', 'shadow-sm');
            pill.classList.remove('text-on-surface-variant', 'font-medium');
        });
    });
</script>
{% endblock %}
