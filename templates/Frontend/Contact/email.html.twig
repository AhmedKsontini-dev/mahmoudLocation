<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'contact.email.title'|trans }}</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333333;
            background-color: #f8fafc;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            overflow: hidden;
        }
        .header {
            background-color: #063B73;
            color: #ffffff;
            padding: 30px 20px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }
        .header p {
            margin: 10px 0 0;
            opacity: 0.9;
        }
        .content {
            padding: 30px 40px;
        }
        .section-title {
            color: #0B5ED7;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 10px;
        }
        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }
        .info-table td {
            padding: 12px 0;
            border-bottom: 1px solid #f1f5f9;
        }
        .info-table td.label {
            font-weight: 600;
            color: #475569;
            width: 35%;
        }
        .info-table td.value {
            color: #1e293b;
        }
        .message-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            margin-top: 10px;
            white-space: pre-wrap;
            color: #334155;
        }
        .footer {
            background-color: #f1f5f9;
            padding: 20px;
            text-align: center;
            font-size: 12px;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
        }
        @media only screen and (max-width: 600px) {
            .container {
                margin: 20px 10px;
            }
            .content {
                padding: 20px;
            }
            .info-table td {
                display: block;
                width: 100%;
            }
            .info-table td.label {
                padding-bottom: 4px;
                border-bottom: none;
            }
            .info-table td.value {
                padding-top: 0;
                padding-bottom: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>{{ 'contact.email.new_message_title'|trans }}</h1>
            <p>LocationMahmoud</p>
        </div>
        
        <div class="content">
            <h2 class="section-title">{{ 'contact.email.visitor_info'|trans }}</h2>
            <table class="info-table">
                <tr>
                    <td class="label">{{ 'contact.form.first_name'|trans }} :</td>
                    <td class="value">{{ contact.firstName }}</td>
                </tr>
                <tr>
                    <td class="label">{{ 'contact.form.last_name'|trans }} :</td>
                    <td class="value">{{ contact.lastName }}</td>
                </tr>
                <tr>
                    <td class="label">{{ 'contact.email.email'|trans }} :</td>
                    <td class="value"><a href="mailto:{{ contact.email }}" style="color: #0B5ED7; text-decoration: none;">{{ contact.email }}</a></td>
                </tr>
                {% if contact.phone %}
                <tr>
                    <td class="label">{{ 'contact.email.phone'|trans }} :</td>
                    <td class="value"><a href="tel:{{ contact.phone }}" style="color: #0B5ED7; text-decoration: none;">{{ contact.phone }}</a></td>
                </tr>
                {% endif %}
                <tr>
                    <td class="label">{{ 'contact.form.request_type'|trans }} :</td>
                    <td class="value">{{ ('contact.form.type_' ~ contact.requestType)|trans }}</td>
                </tr>
                <tr>
                    <td class="label">{{ 'contact.form.service_category'|trans }} :</td>
                    <td class="value">{{ ('contact.form.service_' ~ contact.serviceCategory)|trans }}</td>
                </tr>
                {% if contact.reservationNumber %}
                <tr>
                    <td class="label">{{ 'contact.form.reservation_number'|trans }} :</td>
                    <td class="value">{{ contact.reservationNumber }}</td>
                </tr>
                {% endif %}
                <tr>
                    <td class="label">{{ 'contact.email.send_date'|trans }} :</td>
                    <td class="value">{{ contact.createdAt|date('d/m/Y H:i') }}</td>
                </tr>
            </table>

            <h2 class="section-title">{{ 'contact.email.message_details'|trans }}</h2>
            <div style="margin-bottom: 10px;">
                <span style="font-weight: 600; color: #475569;">{{ 'contact.email.subject'|trans }} :</span>
                <span style="color: #1e293b; margin-left: 10px;">{{ contact.subject }}</span>
            </div>
            
            <div class="message-box">{{ contact.message }}</div>
        </div>
        
        <div class="footer">
            <p>{{ 'contact.email.footer_auto'|trans }}</p>
            <p>&copy; {{ 'now'|date('Y') }} LocationMahmoud. {{ 'contact.email.rights'|trans }}</p>
        </div>
    </div>
</body>
</html>
