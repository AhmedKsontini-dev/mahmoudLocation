{% extends 'baseFront.html.twig' %}

{% block title %}Excursions - Tunisie Travel{% endblock %}

{% block stylesheets %}
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="{{ asset('assetsFront/js/tailwind.config.js') }}"></script>
    <link href="{{ asset('assetsFront/css/home.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsFront/css/excursions.css') }}" rel="stylesheet">
{% endblock %}

{% block javascripts %}
<script src="{{ asset('assetsFront/js/navbar.js') }}?v=2"></script>
<script>
(function () {
    /* ===== Grid / List toggle ===== */
    var STORAGE_KEY = 'excursionsViewMode';
    var container   = document.getElementById('excursions-container');
    var btnGrid     = document.getElementById('btn-view-grid');
    var btnList     = document.getElementById('btn-view-list');

    function applyMode(mode) {
        if (!container) return;
        if (mode === 'list') {
            container.classList.remove('excursions-grid');
            container.classList.add('excursions-list');
            btnList.classList.add('is-active');
            btnGrid.classList.remove('is-active');
        } else {
            container.classList.remove('excursions-list');
            container.classList.add('excursions-grid');
            btnGrid.classList.add('is-active');
            btnList.classList.remove('is-active');
        }
        try { localStorage.setItem(STORAGE_KEY, mode); } catch (e) {}
    }

    var saved = null;
    try { saved = localStorage.getItem(STORAGE_KEY); } catch (e) {}
    if (saved === 'list' || saved === 'grid') { applyMode(saved); }

    if (btnGrid) { btnGrid.addEventListener('click', function () { applyMode('grid'); }); }
    if (btnList) { btnList.addEventListener('click', function () { applyMode('list'); }); }

    /* ===== Price range slider ===== */
    var slider    = document.getElementById('price-range-slider');
    var minLabel  = document.getElementById('range-min-label');
    var maxLabel  = document.getElementById('range-max-label');
    var inputMin  = document.getElementById('filter-min-price');
    var inputMax  = document.getElementById('filter-max-price');

    if (slider) {
        slider.addEventListener('input', function () {
            var val = parseInt(this.value, 10);
            if (maxLabel) maxLabel.textContent = val + ' DT';
            if (inputMax) inputMax.value = val;
        });
        slider.addEventListener('change', function () {
            document.getElementById('filter-form').submit();
        });
    }
})();

/* ===== Duration pill selection ===== */
function setDuration(btn, value) {
    var pills = document.querySelectorAll('#duration-pills .filter-pill');
    pills.forEach(function (p) { p.classList.remove('is-active'); });
    btn.classList.add('is-active');
    var input = document.getElementById('filter-duration');
    if (input) input.value = value;
    document.getElementById('filter-form').submit();
}
</script>
{% endblock %}

{% block body_class %}bg-surface text-on-surface antialiased{% endblock %}

{% block body %}
{% include 'Frontend/Components/_navbar.html.twig' %}

<div class="page-excursions">

    <div class="container">
        {# ---------- Fil d'Ariane ---------- #}
        <div class="breadcrumb">
            <a href="{{ path('app_home') }}">Accueil</a>
            <span>›</span>
            <span class="breadcrumb__current">Excursions</span>
        </div>

        {# ---------- En-tête de page ---------- #}
        <div class="hero-excursions">
            <h1 class="hero-excursions__title">Découvrez la Tunisie</h1>
            <p class="hero-excursions__subtitle">
                Explorez les plus belles destinations de Tunisie avec nos excursions
                sélectionnées et circuits privatifs ou en petit groupe d'exception.
            </p>
        </div>

        {# ---------- Filtres + Liste ---------- #}
        <div class="excursions-layout">

            {# ===== Sidebar filtres ===== #}
            <form id="filter-form" method="get" action="{{ path('app_liste_excursion', {'_locale': _locale}) }}">
            {# Champ caché pour revenir à la page 1 après filtrage #}
            <input type="hidden" name="page" value="1">

            <aside class="filter-panel">
                <div class="filter-panel__header">
                    <h2 class="filter-panel__title">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M7 12h10M10 18h4" />
                        </svg>
                        Filtrer
                    </h2>
                    <a href="{{ path('app_liste_excursion', {'_locale': _locale}) }}" class="filter-panel__reset">Réinitialiser</a>
                </div>

                {# --- Destinations (dynamiques) --- #}
                <div class="filter-group">
                    <h3 class="filter-group__title">DESTINATIONS</h3>
                    <div class="filter-list">
                        {% if destinations|length > 0 %}
                            <div class="filter-item">
                                <label>
                                    <input type="radio" name="destination" value=""
                                        {% if not activeFilters.destination %}checked{% endif %}
                                        onchange="document.getElementById('filter-form').submit()">
                                    Toutes les destinations
                                </label>
                            </div>
                            {% for destination in destinations %}
                                <div class="filter-item">
                                    <label>
                                        <input type="radio" name="destination" value="{{ destination.id }}"
                                            {% if activeFilters.destination == destination.id ~ '' %}checked{% endif %}
                                            onchange="document.getElementById('filter-form').submit()">
                                        {{ destination.getNameTranslated(_locale) }}
                                    </label>
                                    <span class="filter-item__count">{{ destination.excursions|length }}</span>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p style="font-size:13px;color:var(--color-text-muted);">Aucune destination disponible.</p>
                        {% endif %}
                    </div>
                </div>

                {# --- Catégories (même liste radio que les destinations) --- #}
                <div class="filter-group">
                    <h3 class="filter-group__title">CATÉGORIES</h3>
                    <div class="filter-list">
                        {% if categories|length > 0 %}
                            <div class="filter-item">
                                <label>
                                    <input type="radio" name="category" value=""
                                        {% if not activeFilters.category %}checked{% endif %}
                                        onchange="document.getElementById('filter-form').submit()">
                                    Toutes les catégories
                                </label>
                            </div>
                            {% for category in categories %}
                                <div class="filter-item">
                                    <label>
                                        <input type="radio" name="category" value="{{ category.id }}"
                                            {% if activeFilters.category == category.id ~ '' %}checked{% endif %}
                                            onchange="document.getElementById('filter-form').submit()">
                                        {{ (category.icon ? category.icon ~ ' ' : '') ~ (category.getNameTranslated(_locale) ?? category.slug) }}
                                    </label>
                                    <span class="filter-item__count">{{ categoryCounts[category.id] ?? 0 }}</span>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p style="font-size:13px;color:var(--color-text-muted);">Aucune catégorie disponible.</p>
                        {% endif %}
                    </div>
                </div>

                {# --- Durée (dynamique) --- #}
                {% if durations|length > 0 %}
                <div class="filter-group">
                    <h3 class="filter-group__title">DURÉE</h3>
                    {# Champ caché pour la durée sélectionnée via JS #}
                    <input type="hidden" id="filter-duration" name="duration_minutes" value="{{ activeFilters.duration_minutes ?? '' }}">
                    <div class="filter-pills" id="duration-pills">
                        <button type="button" class="filter-pill{% if not activeFilters.duration_minutes %} is-active{% endif %}"
                                data-duration="" onclick="setDuration(this, '')">Toutes</button>
                        {% for dur in durations %}
                            {% set totalMin = dur.total_minutes %}
                            {% set h = dur.hours ?? 0 %}
                            {% set m = dur.minutes ?? 0 %}
                            {% if h > 0 and m > 0 %}
                                {% set label = h ~ 'h' ~ '%02d'|format(m) ~ 'min' %}
                            {% elseif h > 0 %}
                                {% set label = h ~ 'h' %}
                            {% else %}
                                {% set label = m ~ 'min' %}
                            {% endif %}
                            <button type="button"
                                    class="filter-pill{% if activeFilters.duration_minutes == totalMin ~ '' %} is-active{% endif %}"
                                    data-duration="{{ totalMin }}"
                                    onclick="setDuration(this, '{{ totalMin }}')">{{ label }}</button>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {# --- Budget (dynamique) --- #}
                <div class="filter-group" style="border:none;">
                    {# Champs cachés min/max prix #}
                    <input type="hidden" id="filter-min-price" name="min_price" value="{{ activeFilters.min_price ?? priceRange.min|round }}">
                    <input type="hidden" id="filter-max-price" name="max_price" value="{{ activeFilters.max_price ?? priceRange.max|round }}">
                    <div class="filter-range__values">
                        <span>BUDGET / PERS.</span>
                        <span>
                            <span id="range-min-label">{{ (activeFilters.min_price ?? priceRange.min)|round }} DT</span>
                            -
                            <span id="range-max-label">{{ (activeFilters.max_price ?? priceRange.max)|round }} DT</span>
                        </span>
                    </div>
                    <div class="filter-range">
                        <input type="range" id="price-range-slider"
                               min="{{ priceRange.min|round }}"
                               max="{{ priceRange.max|round }}"
                               value="{{ activeFilters.max_price ?? priceRange.max|round }}"
                               step="1">
                    </div>
                    <div class="filter-range__scale">
                        <span>{{ priceRange.min|round }} DT</span>
                        <span>{{ priceRange.max|round }} DT</span>
                    </div>
                </div>
            </aside>
            </form>

            {# ===== Liste des excursions ===== #}
            <main class="excursions-main">
                {# --- Barre d'outils --- #}
                <div class="toolbar">
                    <div class="toolbar__left">
                        <span class="toolbar__count">{{ totalExcursions }} excursion{{ totalExcursions > 1 ? 's' : '' }}</span>
                        <span class="toolbar__tag is-active">Circuits phares</span>
                        <span class="toolbar__tag">Privatisables</span>
                    </div>
                    <div class="toolbar__right">
                        <select class="toolbar__select">
                            <option>Trier par : Plus populaires</option>
                        </select>
                        <div class="view-toggle">
                            <button id="btn-view-grid" class="view-toggle__btn is-active" data-mode="grid" aria-label="Afficher en grille" title="Afficher en grille">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                                    <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                                </svg>
                            </button>
                            <button id="btn-view-list" class="view-toggle__btn" data-mode="list" aria-label="Afficher en liste" title="Afficher en liste">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                {# --- Grille de cartes --- #}
                <div id="excursions-container" class="excursions-grid">
                    {% for excursion in excursions %}
                    <article class="excursion-card">
                        <div class="excursion-card__media">
                            {% set main_image = excursion.images|filter(i => i.isMain)|first %}
                            {% if not main_image %}
                                {% set main_image = excursion.images|first %}
                            {% endif %}
                            <img src="{{ main_image ? asset(main_image.imagePath) : 'https://placehold.co/600x400/e2e8f0/64748b?text=Image+Indisponible' }}" alt="{{ excursion.getTitleTranslated(_locale) }}">
                            
                            {% if excursion.badges|length > 0 %}
                                {% set badge = excursion.badges|first %}
                                <span class="excursion-card__badge" style="background-color: {{ badge.color|default('var(--color-primary)') }};">{{ badge.getTextTranslated(_locale) }}</span>
                            {% endif %}
                            
                            <span class="excursion-card__status">
                                <span class="excursion-card__status-dot"></span> Disponible
                            </span>
                            
                            <div class="excursion-card__location">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c-4-4.5-7-8-7-11a7 7 0 1114 0c0 3-3 6.5-7 11z" />
                                    <circle cx="12" cy="10" r="2.5" />
                                </svg>
                                {{ excursion.getLocationTranslated(_locale) }}
                            </div>
                        </div>
                        <div class="excursion-card__body">
                            <div class="excursion-card__meta">
                                <div class="excursion-card__rating">★ {{ excursion.ratingAverage|default('5.0') }} <span>({{ excursion.ratingCount|default(0) }} avis)</span></div>
                                <div class="excursion-card__duration">
                                    {% if excursion.durationHours %}{{ excursion.durationHours }}h {% endif %}
                                    {% if excursion.durationMinutes %}{{ excursion.durationMinutes }}min{% endif %}
                                </div>
                            </div>
                            <h3 class="excursion-card__title">
                                <a href="{{ path('app_detail_excursion', {'slug': excursion.slug, '_locale': app.request.locale}) }}">{{ excursion.getTitleTranslated(_locale) }}</a>
                            </h3>
                            <p class="excursion-card__desc">{{ excursion.getDescriptionTranslated(_locale)|striptags|slice(0, 100) }}...</p>
                            <div class="excursion-card__details">
                                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/></svg> {{ excursion.type|capitalize }}</span>
                                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg> {{ excursion.minParticipants }}-{{ excursion.maxParticipants }} pers.</span>
                                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg> Multilingue</span>
                            </div>
                            <div class="excursion-card__footer">
                                <p class="excursion-card__price">À partir de <span class="excursion-card__price-value price-val" data-base="{{ excursion.priceAdult }}">{{ excursion.priceAdult|number_format(0, '.', '') }} DT</span> / pers.</p>
                                <div class="excursion-card__actions">
                                    <a href="{{ path('app_detail_excursion', {'slug': excursion.slug, '_locale': app.request.locale}) }}" class="btn btn--outline">Détails</a>
                                    <button class="btn btn--primary">Réserver</button>
                                </div>
                            </div>
                        </div>
                    </article>
                    {% else %}
                    <div class="col-span-full py-12 text-center text-on-surface-variant font-body-md text-body-md">
                        {% if activeFilters.category %}
                            Aucune excursion publiée ne correspond à la catégorie sélectionnée.
                        {% else %}
                            Aucune excursion n'est disponible pour le moment.
                        {% endif %}
                    </div>
                    {% endfor %}

                </div>

                {# --- Pagination --- #}
                {% if totalPages > 0 %}
                <div class="pagination">
                    {% set remaining = totalExcursions - (currentPage * limit) %}
                    {% set routeParams = app.request.attributes.get('_route_params')|default({}) %}
                    {% set queryParams = app.request.query.all %}
                    {% set allParams = routeParams|merge(queryParams) %}
                    {% if remaining > 0 %}
                    <a href="{{ path(app.request.attributes.get('_route'), allParams|merge({'page': currentPage + 1})) }}" class="pagination__more">
                        Afficher plus d'excursions ({{ remaining }} restante{{ remaining > 1 ? 's' : '' }}) 
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                    </a>
                    {% endif %}
                    <div class="pagination__pages">
                        {% if currentPage > 1 %}
                        <a href="{{ path(app.request.attributes.get('_route'), allParams|merge({'page': currentPage - 1})) }}" class="page-link page-link--prev">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="width: 20px; height: 20px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                            Précédent
                        </a>
                        {% endif %}
                        
                        {% for i in 1..totalPages %}
                            <a href="{{ path(app.request.attributes.get('_route'), allParams|merge({'page': i})) }}" class="page-link {% if i == currentPage %}is-active{% endif %}">{{ i }}</a>
                        {% endfor %}
                        
                        {% if currentPage < totalPages %}
                        <a href="{{ path(app.request.attributes.get('_route'), allParams|merge({'page': currentPage + 1})) }}" class="page-link page-link--next">
                            Suivant 
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                        </a>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </main>
        </div>
    </div>

</div>

{% include 'Frontend/Components/_footer.html.twig' %}
{% endblock %}
