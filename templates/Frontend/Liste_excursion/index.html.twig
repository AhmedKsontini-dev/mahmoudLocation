{% extends 'baseFront.html.twig' %}

{% block title %}Excursions - Tunisie Travel{% endblock %}

{% block stylesheets %}
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="{{ asset('assetsFront/js/tailwind.config.js') }}"></script>
    <link href="{{ asset('assetsFront/css/home.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsFront/css/excursions.css') }}" rel="stylesheet">
{% endblock %}

{% block javascripts %}
<script src="{{ asset('assetsFront/js/navbar.js') }}?v=2"></script>
{% endblock %}

{% block body_class %}bg-surface text-on-surface antialiased{% endblock %}

{% block body %}
{% include 'Frontend/Components/_navbar.html.twig' %}

<div class="page-excursions">

    <div class="container">
        {# ---------- Fil d'Ariane ---------- #}
        <div class="breadcrumb">
            <a href="{{ path('app_home') }}">Accueil</a>
            <span>›</span>
            <span class="breadcrumb__current">Excursions</span>
        </div>

        {# ---------- En-tête de page ---------- #}
        <div class="hero-excursions">
            <h1 class="hero-excursions__title">Découvrez la Tunisie</h1>
            <p class="hero-excursions__subtitle">
                Explorez les plus belles destinations de Tunisie avec nos excursions
                sélectionnées et circuits privatifs ou en petit groupe d'exception.
            </p>
        </div>

        {# ---------- Filtres + Liste ---------- #}
        <div class="excursions-layout">

            {# ===== Sidebar filtres ===== #}
            <aside class="filter-panel">
                <div class="filter-panel__header">
                    <h2 class="filter-panel__title">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M7 12h10M10 18h4" />
                        </svg>
                        Filtrer
                    </h2>
                    <a href="{{ path('app_liste_excursion') }}" class="filter-panel__reset">Réinitialiser</a>
                </div>

                {# --- Destinations --- #}
                <div class="filter-group">
                    <h3 class="filter-group__title">DESTINATIONS</h3>
                    <div class="filter-list">
                        <div class="filter-item">
                            <label><input type="checkbox" checked> Tunis & Carthage</label>
                            <span class="filter-item__count">5</span>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox" checked> Sidi Bou Said</label>
                            <span class="filter-item__count">4</span>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox"> Hammamet & Cap Bon</label>
                            <span class="filter-item__count">3</span>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox"> Sousse & Monastir</label>
                            <span class="filter-item__count">3</span>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox"> El Jem & Kairouan</label>
                            <span class="filter-item__count">4</span>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox" checked> Sahara & Douz</label>
                            <span class="filter-item__count">3</span>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox"> Djerba la Douce</label>
                            <span class="filter-item__count">2</span>
                        </div>
                    </div>
                </div>

                {# --- Type d'expérience --- #}
                <div class="filter-group">
                    <h3 class="filter-group__title">TYPE D'EXPÉRIENCE</h3>
                    <div class="filter-list">
                        <div class="filter-item">
                            <label><input type="checkbox" checked> Culture & Histoire</label>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox" checked> Désert & Aventure</label>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox"> Plage & Détente côtière</label>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox" checked> Excursion privée VIP</label>
                        </div>
                        <div class="filter-item">
                            <label><input type="checkbox"> Petit groupe (max 8)</label>
                        </div>
                    </div>
                </div>

                {# --- Durée --- #}
                <div class="filter-group">
                    <h3 class="filter-group__title">DURÉE</h3>
                    <div class="filter-pills">
                        <button class="filter-pill">1/2 Journée</button>
                        <button class="filter-pill is-active">1 Journée</button>
                        <button class="filter-pill">2 Jours</button>
                        <button class="filter-pill">3+ Jours</button>
                    </div>
                </div>

                {# --- Budget --- #}
                <div class="filter-group" style="border:none;">
                    <div class="filter-range__values">
                        <span>BUDGET / PERS.</span>
                        <span><span class="price-val" data-base="50">{{ 50|price }}</span> - <span class="price-val" data-base="500">{{ 500|price }}</span></span>
                    </div>
                    <div class="filter-range">
                        <input type="range" min="50" max="1000" value="500">
                    </div>
                    <div class="filter-range__scale">
                        <span class="price-val" data-base="50">{{ 50|price }}</span>
                        <span class="price-val" data-base="1000">{{ 1000|price }}</span>
                    </div>
                </div>
            </aside>

            {# ===== Liste des excursions ===== #}
            <main class="excursions-main">
                {# --- Barre d'outils --- #}
                <div class="toolbar">
                    <div class="toolbar__left">
                        <span class="toolbar__count">18 excursions</span>
                        <span class="toolbar__tag is-active">Circuits phares</span>
                        <span class="toolbar__tag">Privatisables</span>
                    </div>
                    <div class="toolbar__right">
                        <select class="toolbar__select">
                            <option>Trier par : Plus populaires</option>
                        </select>
                        <div class="view-toggle">
                            <button class="view-toggle__btn is-active">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                                    <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                                </svg>
                            </button>
                            <button class="view-toggle__btn">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
                                </svg>
