{% extends 'baseFront.html.twig' %}

{% form_theme bookingForm _self %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="mt-1 text-xs text-red-600 font-medium space-y-0.5">
            {% for error in errors %}
                <div class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">error</span>
                    <span>{{ error.message }}</span>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block title %}{{ excursion.getTranslation(_locale) ? excursion.getTranslation(_locale).metaTitle|default(excursion.getTitleTranslated(_locale)) : excursion.getTitleTranslated(_locale) }} - Yassmine Guide{% endblock %}

{% block stylesheets %}
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="{{ asset('assetsFront/js/tailwind.config.js') }}"></script>
    <link href="{{ asset('assetsFront/css/excursions.css') }}" rel="stylesheet">
{% endblock %}

{% block body_class %}bg-surface text-on-surface antialiased{% endblock %}

{% block body %}
{% include 'Frontend/Components/_navbar.html.twig' %}

<main class="w-full pt-20 bg-surface min-h-screen">
    {# Breadcrumb and Badges #}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-4 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-surface-container">
        <nav class="flex items-center gap-2 font-label-md text-label-md text-on-surface-variant">
            <a href="{{ path('app_home_locale', {'_locale': _locale}) }}" class="hover:text-primary transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">home</span>
                {{ 'excursion.detail.home'|trans }}
            </a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <a href="#" class="hover:text-primary transition-colors">{{ excursion.category.getTranslation(_locale) ? excursion.category.getTranslation(_locale).name : (excursion.category.getTranslation('fr') ? excursion.category.getTranslation('fr').name : 'excursion.detail.category'|trans) }}</a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <span class="text-on-surface font-semibold">{{ excursion.getTitleTranslated(_locale) }}</span>
        </nav>
        <div class="flex items-center gap-3">
            {% for badge in excursion.badges %}
                {% if badge.isActive %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-high font-label-md text-label-md text-primary">
                    {% if badge.badgeType == 'available_now' %}
                        <span class="w-2 h-2 rounded-full bg-tertiary-container animate-pulse"></span>
                    {% elseif badge.badgeType == 'private_guided' %}
                        <span class="material-symbols-outlined text-[16px]">verified_user</span>
                    {% elseif badge.badgeType == 'best_seller' %}
                        <span class="material-symbols-outlined text-[16px]">star</span>
                    {% endif %}
                    {{ badge.getTextTranslated(_locale) }}
                </span>
                {% endif %}
            {% endfor %}
        </div>
    </div>

    {# Header Section #}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-8">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
            <div class="flex-1">
                <div class="flex items-center gap-2 mb-3">
                    {% if excursion.isBestSeller %}
                        <span class="px-2.5 py-1 rounded-md bg-primary text-on-primary font-label-md text-label-md uppercase tracking-wider">{{ 'excursion.detail.best_seller'|trans }}</span>
                    {% endif %}
                    <span class="px-2.5 py-1 rounded-md bg-surface-container-high text-on-surface-variant font-label-md text-label-md">
                        {{ ('excursion.detail.type.' ~ excursion.type)|trans }}
                    </span>
                </div>
                <h1 class="font-display-mobile md:font-display text-display-mobile md:text-display text-on-surface mb-4">{{ excursion.getTitleTranslated(_locale) }}</h1>
                
                <div class="flex flex-wrap items-center gap-4 font-body-md text-body-md text-on-surface-variant">
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">location_on</span>
                        <span>{{ excursion.getLocationTranslated(_locale) }}</span>
                    </div>
                    {% if excursion.durationHours or excursion.durationMinutes %}
                    <span class="text-surface-container-high hidden md:inline">•</span>
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">schedule</span>
                        <span>
                            {% if excursion.durationHours %}{{ excursion.durationHours }}h {% endif %}
                            {% if excursion.durationMinutes %}{{ excursion.durationMinutes }}min{% endif %}
                        </span>
                    </div>
                    {% endif %}
                    {% if excursion.ratingCount > 0 %}
                    <span class="text-surface-container-high hidden md:inline">•</span>
                    <div class="flex items-center gap-1.5 text-secondary-container font-semibold">
                        <span class="material-symbols-outlined text-[18px] text-amber-400">star</span>
                        <span class="text-amber-500">{{ excursion.ratingAverage }} / 5</span>
                        <span class="text-on-surface-variant font-normal">({{ 'excursion.detail.verified_reviews'|trans({'%count%': excursion.ratingCount}) }})</span>
                    </div>
                    {% endif %}
                </div>
            </div>
            <div class="flex items-center gap-3 shrink-0">
                <button class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg border border-surface-container hover:bg-surface-container-low transition-all">
                    <span class="material-symbols-outlined text-[20px]">share</span>
                    <span>{{ 'excursion.detail.share'|trans }}</span>
                </button>
                <button class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg border border-surface-container hover:bg-surface-container-low transition-all">
                    <span class="material-symbols-outlined text-[20px]">favorite_border</span>
                    <span>{{ 'excursion.detail.save'|trans }}</span>
                </button>
            </div>
        </div>
    </div>

    {# Images Grid #}
    {% if excursion.images|length > 0 %}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop mb-8">
        {% set gallery_images = [] %}
        {% for gallery_image in excursion.images %}
            {% set gallery_images = gallery_images|merge([{
                src: asset(gallery_image.imagePath),
                alt: gallery_image.getAltTextTranslated(_locale),
                caption: gallery_image.getCaptionTranslated(_locale)
            }]) %}
        {% endfor %}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 h-[400px] md:h-[500px]" data-excursion-gallery data-gallery-images="{{ gallery_images|json_encode|e('html_attr') }}">
            {% set main_image = null %}
            {% for img in excursion.images %}
                {% if img.isMain and not main_image %}
                    {% set main_image = img %}
                {% endif %}
            {% endfor %}
            {% if not main_image %}
                {% set main_image = excursion.images|first %}
            {% endif %}
            
            <div class="md:col-span-2 relative h-full rounded-2xl overflow-hidden group">
                <img src="{{ asset(main_image.imagePath) }}" alt="{{ main_image.getAltTextTranslated(_locale) }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 cursor-zoom-in" data-gallery-trigger role="button" tabindex="0" aria-label="{{ 'excursion.detail.gallery.enlarge'|trans }}">
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                {% if main_image.getCaptionTranslated(_locale) %}
                <div class="pointer-events-none absolute bottom-4 left-4 text-white font-title-md text-title-md">{{ main_image.getCaptionTranslated(_locale) }}</div>
                {% endif %}
                <button type="button" data-gallery-trigger data-gallery-src="{{ asset(main_image.imagePath) }}" class="absolute bottom-4 right-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black/50 backdrop-blur-md text-white font-label-md text-label-md hover:bg-black/70 transition-colors">
                    <span class="material-symbols-outlined text-[20px]">photo_camera</span>
                    <span>{{ 'excursion.detail.gallery.photos'|trans({'%count%': excursion.images|length}) }}</span>
                </button>
            </div>
            
            <div class="hidden md:flex flex-col gap-4 h-full">
                {% set side_count = 0 %}
                {% for side_image in excursion.images %}
                    {% if side_image.id != main_image.id and side_count < 2 %}
                        <div class="relative h-[calc(50%-0.5rem)] rounded-2xl overflow-hidden group">
                            <img src="{{ asset(side_image.imagePath) }}" alt="{{ side_image.getAltTextTranslated(_locale) }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 cursor-zoom-in" data-gallery-trigger role="button" tabindex="0" aria-label="{{ 'excursion.detail.gallery.enlarge'|trans }}">
                            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                            {% if side_image.getCaptionTranslated(_locale) %}
                            <div class="pointer-events-none absolute bottom-4 left-4 text-white font-title-md text-title-md text-sm">{{ side_image.getCaptionTranslated(_locale) }}</div>
                            {% endif %}
                        </div>
                        {% set side_count = side_count + 1 %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
    <div id="excursion-gallery-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-3 sm:p-6" data-gallery-modal aria-hidden="true">
        <section class="relative flex h-full w-full max-w-7xl items-center justify-center" role="dialog" aria-modal="true" aria-label="{{ 'excursion.detail.gallery.title'|trans }}" tabindex="-1" data-gallery-dialog>
            <button type="button" class="absolute right-1 top-1 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-black/55 text-3xl leading-none text-white transition hover:bg-black/80 sm:right-2 sm:top-2" aria-label="{{ 'excursion.detail.gallery.close'|trans }}" data-gallery-close>×</button>
            <button type="button" class="absolute left-0 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/55 text-3xl leading-none text-white transition hover:bg-black/80 sm:left-2 sm:h-12 sm:w-12" aria-label="{{ 'excursion.detail.gallery.previous'|trans }}" data-gallery-previous>←</button>
            <img class="max-h-[78vh] max-w-[78vw] select-none object-contain sm:max-h-[84vh] sm:max-w-[86vw]" alt="" data-gallery-image>
            <button type="button" class="absolute right-0 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/55 text-3xl leading-none text-white transition hover:bg-black/80 sm:right-2 sm:h-12 sm:w-12" aria-label="{{ 'excursion.detail.gallery.next'|trans }}" data-gallery-next>→</button>
            <div class="absolute bottom-2 left-1/2 -translate-x-1/2 text-center text-sm text-white" aria-live="polite">
                <p class="mb-1" data-gallery-caption hidden></p>
                <span data-gallery-count></span>
            </div>
        </section>
    </div>
    {% else %}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop mb-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 h-[400px] md:h-[500px]">
             <div class="md:col-span-3 relative h-full rounded-2xl overflow-hidden group bg-surface-container flex items-center justify-center">
                 <span class="material-symbols-outlined text-[48px] text-on-surface-variant">image</span>
             </div>
        </div>
    </div>
    {% endif %}

    {# Key Features Bar #}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop mb-12">
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-container p-6 flex flex-wrap md:flex-nowrap items-center justify-between gap-6">
            <div class="flex items-center gap-4 w-full md:w-auto">
                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">schedule</span>
                </div>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-0.5">{{ 'excursion.detail.duration'|trans }}</div>
                    <div class="font-title-md text-title-md text-on-surface">
                        {% if excursion.durationHours %}{{ excursion.durationHours }}{{ 'excursion.detail.hours_short'|trans }} {% endif %}
                        {% if excursion.durationMinutes %}{{ excursion.durationMinutes }}{{ 'excursion.detail.minutes_short'|trans }}{% endif %}
                        {% if excursion.startTime and excursion.endTime %}
                            ({{ excursion.startTime|date('H:i') }}-{{ excursion.endTime|date('H:i') }})
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="hidden md:block w-px h-12 bg-surface-container"></div>
            <div class="flex items-center gap-4 w-full md:w-auto">
                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">group</span>
                </div>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-0.5">{{ 'excursion.detail.participants'|trans }}</div>
                    <div class="font-title-md text-title-md text-on-surface">{{ 'excursion.detail.participant_range'|trans({'%min%': excursion.minParticipants, '%max%': excursion.maxParticipants}) }}</div>
                </div>
            </div>
            <div class="hidden md:block w-px h-12 bg-surface-container"></div>
            <div class="flex items-center gap-4 w-full md:w-auto">
                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">hotel</span>
                </div>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-0.5">{{ 'excursion.detail.pickup'|trans }}</div>
                    <div class="font-title-md text-title-md text-on-surface">{{ 'excursion.detail.hotel_pickup'|trans }}</div>
                </div>
            </div>
            <div class="hidden md:block w-px h-12 bg-surface-container"></div>
            <div class="flex items-center gap-4 w-full md:w-auto">
                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">verified_user</span>
                </div>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-0.5">{{ 'excursion.detail.cancellation'|trans }}</div>
                    <div class="font-title-md text-title-md text-on-surface">{{ 'excursion.detail.free_cancellation_hours'|trans({'%hours%': excursion.cancellationHours}) }}</div>
                </div>
            </div>
        </div>
    </div>

    {# Main Content & Sidebar #}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop pb-24">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            {# Left Column #}
            <div class="lg:col-span-2 flex flex-col gap-12">
                
                {# Ce que vous allez vivre #}
                {% if excursion.getDescriptionTranslated(_locale) %}
                <section>
                    <div class="flex items-center gap-3 mb-6">
                        <span class="material-symbols-outlined text-primary text-[28px]">explore</span>
                        <h2 class="font-headline-md text-headline-md text-on-surface">{{ 'excursion.detail.experience_title'|trans }}</h2>
                    </div>
                    <div class="font-body-lg text-body-lg text-on-surface-variant mb-8 leading-relaxed raw-html">
                        {{ excursion.getDescriptionTranslated(_locale)|raw }}
                    </div>
                    {% if excursion.features|length > 0 %}
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        {% for feature in excursion.features %}
                        <div class="bg-surface-container-low rounded-xl p-4 text-center flex flex-col items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[24px]">{{ feature.icon }}</span>
                            <div>
                                <div class="font-label-md text-label-md text-on-surface">{{ feature.getTitleTranslated(_locale) }}</div>
                                <div class="font-body-sm text-body-sm text-on-surface-variant">{{ feature.getSubtitleTranslated(_locale) }}</div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </section>
                {% endif %}

                {# Programme de la Journée #}
                {% if excursion.itineraries|length > 0 %}
                <section>
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-[28px]">map</span>
                            <h2 class="font-headline-md text-headline-md text-on-surface">{{ 'excursion.detail.itinerary_title'|trans }}</h2>
                        </div>
                        <span class="px-3 py-1.5 rounded-md bg-surface-container-high text-primary font-label-md text-label-md self-start md:self-auto">{{ 'excursion.detail.relaxed_pace'|trans }}</span>
                    </div>
                    
                    <div class="relative pl-6 md:pl-8 border-l-2 border-surface-container space-y-10 ml-4">
                        {% for step in excursion.itineraries %}
                        <div class="relative">
                            <div class="absolute -left-[43px] md:-left-[51px] w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm ring-4 ring-surface">{{ step.stepNumber }}</div>
                            <h3 class="font-title-md text-title-md text-on-surface mb-2">
                                {% if step.time %}{{ step.time|date('H:i') }} — {% endif %}{{ step.getTitleTranslated(_locale) }}
                            </h3>
                            <p class="font-body-md text-body-md text-on-surface-variant">{{ step.getDescriptionTranslated(_locale) }}</p>
                        </div>
                        {% endfor %}
                    </div>
                </section>
                {% endif %}

                {# Inclus / Non Inclus #}
                {% if excursion.inclusions|length > 0 %}
                <section>
                    <h2 class="font-headline-md text-headline-md text-on-surface mb-6">{{ 'excursion.detail.inclusions_title'|trans }}</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-surface-container-low rounded-2xl p-6">
                            <div class="flex items-center gap-2 mb-4 text-green-700 font-title-md text-title-md">
                                <span class="material-symbols-outlined">check_circle</span>
                                {{ 'excursion.detail.included'|trans }}
                            </div>
                            <ul class="space-y-3">
                                {% for item in excursion.inclusions|filter(i => i.type == 'included') %}
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-green-600 text-[20px] shrink-0">{{ item.icon|default('check') }}</span>
                                    {{ item.getTextTranslated(_locale) }}
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="bg-surface-container-high/50 rounded-2xl p-6 border border-surface-container">
                            <div class="flex items-center gap-2 mb-4 text-error font-title-md text-title-md">
                                <span class="material-symbols-outlined">cancel</span>
                                {{ 'excursion.detail.excluded'|trans }}
                            </div>
                            <ul class="space-y-3">
                                {% for item in excursion.inclusions|filter(i => i.type == 'excluded') %}
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-outline text-[20px] shrink-0">{{ item.icon|default('close') }}</span>
                                    {{ item.getTextTranslated(_locale) }}
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </section>
                {% endif %}

                {% for reservation in app.flashes('reservation_success') %}
                    <div id="reservation-status" role="status" class="mb-6 rounded-2xl border border-green-200 bg-green-50 p-6 text-green-950">
                        <h2 class="font-headline-md text-headline-md mb-2 flex items-center gap-2">
                            <span class="material-symbols-outlined text-green-600 text-[28px]">check_circle</span>
                            {{ 'excursion_reservation.success.title'|trans }}
                        </h2>
                        <p class="font-body-md mb-5">{{ 'excursion_reservation.success.message'|trans }}</p>
                        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 font-body-sm">
                            <div><dt class="font-semibold text-green-900">{{ 'excursion_reservation.summary.excursion'|trans }}</dt><dd class="text-green-800">{{ reservation.excursion }}</dd></div>
                            <div><dt class="font-semibold text-green-900">{{ 'excursion_reservation.summary.customer'|trans }}</dt><dd class="text-green-800">{{ reservation.prenom }} {{ reservation.nom }}</dd></div>
                            <div><dt class="font-semibold text-green-900">{{ 'excursion_reservation.summary.date_time'|trans }}</dt><dd class="text-green-800">{{ 'excursion_reservation.summary.date_time_value'|trans({'%date%': reservation.date, '%time%': reservation.heure}) }}</dd></div>
                            <div>
                                <dt class="font-semibold text-green-900">{{ 'excursion_reservation.summary.participants'|trans }}</dt>
                                <dd class="text-green-800">
                                    {{ reservation.adultes }} {{ (reservation.adultes == 1 ? 'excursion_reservation.summary.adult_one' : 'excursion_reservation.summary.adult_other')|trans }},
                                    {{ reservation.enfants }} {{ (reservation.enfants == 1 ? 'excursion_reservation.summary.child_one' : 'excursion_reservation.summary.child_other')|trans }}
                                </dd>
                            </div>
                            <div><dt class="font-semibold text-green-900">{{ 'excursion_reservation.summary.pickup_location'|trans }}</dt><dd class="text-green-800">{{ reservation.lieu }}</dd></div>
                            <div><dt class="font-semibold text-green-900">{{ 'excursion_reservation.summary.status'|trans }}</dt><dd class="text-green-800"><span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">{{ 'excursion_reservation.status.pending'|trans }}</span></dd></div>
                        </dl>
                    </div>
                {% endfor %}

                {% for message in app.flashes('reservation_error') %}
                    <div role="alert" class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-6 text-red-950 flex items-start gap-3">
                        <span class="material-symbols-outlined text-red-600 text-[24px] shrink-0 mt-0.5">error</span>
                        <div>
                            <h2 class="font-title-md text-title-md font-semibold mb-1 text-red-900">{{ 'excursion.detail.booking_failure'|trans }}</h2>
                            <p class="font-body-md text-red-800">{{ message|trans }}</p>
                        </div>
                    </div>
                {% endfor %}

                {% if bookingForm.vars.submitted and not bookingForm.vars.valid %}
                    <div role="alert" class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-6 text-red-950 flex items-start gap-3">
                        <span class="material-symbols-outlined text-red-600 text-[24px] shrink-0 mt-0.5">warning</span>
                        <div>
                            <h2 class="font-title-md text-title-md font-semibold mb-1 text-red-900">{{ 'excursion.detail.invalid_form_title'|trans }}</h2>
                            <p class="font-body-md text-red-800">{{ 'excursion.detail.invalid_form_message'|trans }}</p>
                        </div>
                    </div>
                {% endif %}

                <section class="bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-container p-6 md:p-8">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="material-symbols-outlined text-primary text-[28px]">event_available</span>
                        <h2 class="font-headline-md text-headline-md text-on-surface">{{ 'excursion.detail.booking_form_title'|trans }}</h2>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface-variant mb-8">{{ 'excursion.detail.booking_form_intro'|trans }}</p>

                    {{ form_start(bookingForm, {'attr': {'class': 'space-y-8', 'id': 'booking-form'}}) }}
                        {{ form_errors(bookingForm) }}
                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm">1</div>
                                <h3 class="font-title-md text-title-md text-on-surface">{{ 'excursion.detail.date_participants'|trans }}</h3>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 bg-surface-container-low p-4 rounded-xl">
                                {% for field in [bookingForm.dateExcursion, bookingForm.heureDepart, bookingForm.nombreAdultes, bookingForm.nombreEnfants] %}
                                    <div>
                                        {{ form_label(field) }}
                                        {{ form_widget(field) }}
                                        {{ form_errors(field) }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm">2</div>
                                <h3 class="font-title-md text-title-md text-on-surface">{{ 'excursion.detail.pickup'|trans }}</h3>
                            </div>
                            <div class="bg-surface-container-low p-4 rounded-xl">
                                {{ form_label(bookingForm.lieuPriseEnCharge) }}
                                {{ form_widget(bookingForm.lieuPriseEnCharge) }}
                                {{ form_errors(bookingForm.lieuPriseEnCharge) }}
                            </div>
                        </div>

                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm">3</div>
                                <h3 class="font-title-md text-title-md text-on-surface">{{ 'excursion.detail.contact_details'|trans }}</h3>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 bg-surface-container-low p-4 rounded-xl">
                                {% for field in [bookingForm.nom, bookingForm.prenom, bookingForm.email, bookingForm.whatsapp] %}
                                    <div>
                                        {{ form_label(field) }}
                                        {{ form_widget(field) }}
                                        {{ form_errors(field) }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <button type="submit" class="w-full h-14 rounded-xl bg-primary text-on-primary font-title-md text-title-md shadow-md hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">event_available</span>
                            {{ 'excursion.detail.book_button'|trans }}
                        </button>
                    {{ form_end(bookingForm) }}
                </section>

            </div>

            {# Right Column (Sticky Pricing Sidebar) #}
            <div class="lg:col-span-1">
                <div class="sticky top-28 bg-surface-container-lowest rounded-2xl shadow-lg border border-surface-container p-6">
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-label-md text-label-md text-on-surface-variant">{{ 'excursion.detail.price_per_person'|trans }}</span>
                        <span class="px-2.5 py-1 rounded-md bg-secondary-container text-on-secondary-container font-label-md text-label-md">{{ ('excursion.detail.type.' ~ excursion.type)|trans }}</span>
                    </div>
                    <div class="flex items-end gap-2 mb-6">
                        <span class="font-display text-display text-primary leading-none" data-price-base="{{ excursion.priceAdult }}">{{ excursion.priceAdult|price }}</span>
                    </div>
                    
                    <div class="space-y-3 mb-6 font-body-md text-body-md text-on-surface-variant pb-6 border-b border-surface-container">
                        <div class="flex justify-between items-center">
                            <span>{{ 'excursion.detail.adult_price'|trans }}</span>
                            <span class="text-on-surface font-medium" data-price-base="{{ excursion.priceAdult }}">{{ excursion.priceAdult|price }}</span>
                        </div>
                        {% if excursion.priceChild %}
                        <div class="flex justify-between items-center">
                            <span>{{ 'excursion.detail.child_price'|trans }}</span>
                            <span class="text-on-surface font-medium" data-price-base="{{ excursion.priceChild }}">{{ excursion.priceChild|price }}</span>
                        </div>
                        {% endif %}
                        <div class="flex justify-between items-center">
                            <span>{{ 'excursion.detail.pickup_return'|trans }}</span>
                            <span class="font-label-md text-label-md text-on-surface">{{ 'excursion.detail.included'|trans }}</span>
                        </div>
                    </div>

                    <div class="flex justify-between items-end mb-6">
                        <span class="font-title-md text-title-md text-on-surface">{{ 'excursion.detail.from_price'|trans }}</span>
                        <div class="text-right">
                            <div class="font-headline-md text-headline-md text-on-surface leading-none mb-1" data-price-base="{{ excursion.priceAdult * excursion.minParticipants }}">{{ (excursion.priceAdult * excursion.minParticipants)|price }}</div>
                        </div>
                    </div>

                    <div class="bg-surface-container-low rounded-xl p-4 flex gap-3 mb-6">
                        <span class="material-symbols-outlined text-green-600 shrink-0">task_alt</span>
                        <p class="font-label-sm text-label-sm text-on-surface">{{ 'excursion.detail.payment_notice'|trans }}</p>
                    </div>

                    <ul class="space-y-3 font-body-sm text-body-sm text-on-surface-variant">
                        <li class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">verified</span>
                            {{ 'excursion.detail.certified_drivers'|trans }}
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">event_busy</span>
                            {{ 'excursion.detail.free_cancellation_hours'|trans({'%hours%': excursion.cancellationHours}) }}
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">support_agent</span>
                            {{ 'excursion.detail.whatsapp_support'|trans }}
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    {# Reviews Section #}
    {% set approved_reviews = excursion.reviews|filter(r => r.status == 'approved') %}
    {% if approved_reviews|length > 0 %}
    <div class="bg-surface-container-lowest py-16 border-t border-surface-container">
        <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop">
            <div class="flex items-end justify-between mb-8">
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface mb-2">{{ 'excursion.detail.reviews_title'|trans }}</h2>
                    <p class="font-body-md text-body-md text-on-surface-variant">{{ 'excursion.detail.reviews_summary'|trans({'%rating%': excursion.ratingAverage|default('5.0'), '%count%': excursion.ratingCount > 0 ? excursion.ratingCount : approved_reviews|length}) }}</p>
                </div>
                <div class="font-headline-sm text-headline-sm text-amber-500 flex items-center gap-1 font-bold">
                    <span class="material-symbols-outlined text-[24px]">star</span>
                    {{ excursion.ratingAverage|default('5.0') }} / 5
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {% for review in approved_reviews|slice(0, 3) %}
                <div class="bg-surface rounded-2xl p-6 border border-surface-container">
                    <div class="flex text-amber-400 mb-4 text-sm">
                        {% for i in 1..5 %}
                            {% if i <= review.rating %}★{% else %}☆{% endif %}
                        {% endfor %}
                    </div>
                    <p class="font-body-md text-body-md text-on-surface italic mb-4">« {{ review.comment }} »</p>
                    <div class="font-label-md text-label-md text-on-surface-variant"><span class="text-on-surface font-bold">{{ review.customerName }}</span>{% if review.customerLocation %} • {{ review.customerLocation }}{% endif %}</div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

    {# FAQ Section #}
    {% set active_faqs = excursion.faqs|filter(f => f.isActive) %}
    {% if active_faqs|length > 0 %}
    <div class="bg-surface py-16">
        <div class="max-w-4xl mx-auto px-margin-mobile md:px-margin-desktop">
            <h2 class="font-headline-md text-headline-md text-on-surface text-center mb-10">{{ 'excursion.detail.faq_title'|trans }}</h2>
            <div class="space-y-4">
                {% for faq in active_faqs %}
                <div class="bg-surface-container-lowest rounded-xl border border-surface-container flex flex-col group transition-all">
                    <div class="p-5 flex justify-between items-center cursor-pointer hover:bg-surface-container-low transition-colors" onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('.material-symbols-outlined').classList.toggle('rotate-180')">
                        <span class="font-title-md text-title-md text-on-surface">{{ faq.getQuestionTranslated(_locale) }}</span>
                        <span class="material-symbols-outlined text-outline transition-transform duration-300">expand_more</span>
                    </div>
                    <div class="hidden px-5 pb-5 font-body-md text-body-md text-on-surface-variant">
                        {{ faq.getAnswerTranslated(_locale)|nl2br }}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

    <section class="section-destinations">
        <div class="container">
            <p class="section-eyebrow">{{ 'excursion.detail.destinations.eyebrow'|trans }}</p>
            <div class="section-heading">
                <h2 class="section-heading__title">{{ 'excursion.detail.destinations.title'|trans }}</h2>
                <p class="section-heading__desc">
                    {{ 'excursion.detail.destinations.description'|trans }}
                </p>
            </div>
            <div class="destinations-grid">
                {% for destinationData in destinations %}
                    {% set destination = destinationData.destination %}
                    <a href="{{ path('app_liste_excursion', {'_locale': _locale, 'destination': destination.id}) }}" class="destination-card">
                        <img src="{{ asset('assetsFront/images/destination-placeholder.svg') }}" alt="{{ destination.getNameTranslated(_locale) }}">
                        <div class="destination-card__info">
                            <h3 class="destination-card__name">{{ destination.getNameTranslated(_locale) }}</h3>
                            <p class="destination-card__count">{{ ('destination.excursion_count.' ~ (destinationData.excursionCount == 1 ? 'one' : 'other'))|trans({'%count%': destinationData.excursionCount}) }}</p>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    {% include 'Frontend/Components/_footer.html.twig' %}
</main>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('assetsFront/js/navbar.js') }}?v=2"></script>
<script src="{{ asset('assetsFront/js/excursion-gallery.js') }}"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const bookingForm = document.getElementById('booking-form');
        if (bookingForm) {
            bookingForm.addEventListener('submit', function (e) {
                if (bookingForm.dataset.submitting === 'true') {
                    e.preventDefault();
                    return false;
                }
                if (bookingForm.checkValidity && !bookingForm.checkValidity()) {
                    return;
                }
                bookingForm.dataset.submitting = 'true';
                const submitBtn = bookingForm.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
                }
            });
        }
    });
</script>
{% endblock %}
