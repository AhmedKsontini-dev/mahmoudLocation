{% extends 'baseFront.html.twig' %}

{% block title %}Sidi Bou Saïd & Carthage Antique - Tunisia Travel{% endblock %}

{% block stylesheets %}
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="{{ asset('assetsFront/js/tailwind.config.js') }}"></script>
{% endblock %}

{% block body_class %}bg-surface text-on-surface antialiased{% endblock %}

{% block body %}
{% include 'Frontend/Components/_navbar.html.twig' %}

<main class="w-full pt-20 bg-surface min-h-screen">
    {# Breadcrumb and Badges #}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-4 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-surface-container">
        <nav class="flex items-center gap-2 font-label-md text-label-md text-on-surface-variant">
            <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Accueil
            </a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <a href="#" class="hover:text-primary transition-colors">Excursions privées</a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <span class="text-on-surface font-semibold">Sidi Bou Saïd & Carthage</span>
        </nav>
        <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-high font-label-md text-label-md text-primary">
                <span class="w-2 h-2 rounded-full bg-tertiary-container animate-pulse"></span>
                Disponible immédiatement
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-high font-label-md text-label-md text-primary">
                <span class="material-symbols-outlined text-[16px]">verified_user</span>
                Circuit Privé & Guidé
            </span>
        </div>
    </div>

    {# Header Section #}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-8">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
            <div class="flex-1">
                <div class="flex items-center gap-2 mb-3">
                    <span class="px-2.5 py-1 rounded-md bg-primary text-on-primary font-label-md text-label-md uppercase tracking-wider">MEILLEURE VENTE</span>
                    <span class="px-2.5 py-1 rounded-md bg-surface-container-high text-on-surface-variant font-label-md text-label-md">Privé & Guidé</span>
                </div>
                <h1 class="font-display-mobile md:font-display text-display-mobile md:text-display text-on-surface mb-4">Sidi Bou Saïd & Carthage Antique</h1>
                
                <div class="flex flex-wrap items-center gap-4 font-body-md text-body-md text-on-surface-variant">
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">location_on</span>
                        <span>Tunis, Carthage & La Marsa</span>
                    </div>
                    <span class="text-surface-container-high hidden md:inline">•</span>
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">schedule</span>
                        <span>1 journée complète (8h30 – 17h00)</span>
                    </div>
                    <span class="text-surface-container-high hidden md:inline">•</span>
                    <div class="flex items-center gap-1.5 text-secondary-container font-semibold">
                        <span class="material-symbols-outlined text-[18px] text-amber-400">star</span>
                        <span class="text-amber-500">4.9 / 5</span>
                        <span class="text-on-surface-variant font-normal">(124 avis vérifiés)</span>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-3 shrink-0">
                <button class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg border border-surface-container hover:bg-surface-container-low transition-all">
                    <span class="material-symbols-outlined text-[20px]">share</span>
                    <span>Partager</span>
                </button>
                <button class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg border border-surface-container hover:bg-surface-container-low transition-all">
                    <span class="material-symbols-outlined text-[20px]">favorite_border</span>
                    <span>Sauvegarder</span>
                </button>
            </div>
        </div>
    </div>

    {# Images Grid #}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop mb-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 h-[400px] md:h-[500px]">
            <div class="md:col-span-2 relative h-full rounded-2xl overflow-hidden group">
                <img src="https://images.unsplash.com/photo-1574360773950-705b637d7a8d?auto=format&fit=crop&q=80&w=1200" alt="Sidi Bou Said" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-4 text-white font-title-md text-title-md">Vue panoramique sur le Golfe de Carthage</div>
                <button class="absolute bottom-4 right-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black/50 backdrop-blur-md text-white font-label-md text-label-md hover:bg-black/70 transition-colors">
                    <span class="material-symbols-outlined text-[20px]">photo_camera</span>
                    <span>4 photos</span>
                </button>
            </div>
            <div class="hidden md:flex flex-col gap-4 h-full">
                <div class="relative h-[calc(50%-0.5rem)] rounded-2xl overflow-hidden group">
                    <img src="https://images.unsplash.com/photo-1601662528567-526cd06f3621?auto=format&fit=crop&q=80&w=600" alt="Carthage" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-4 left-4 text-white font-title-md text-title-md text-sm">Ruines de Carthage</div>
                </div>
                <div class="relative h-[calc(50%-0.5rem)] rounded-2xl overflow-hidden group">
                    <img src="https://images.unsplash.com/photo-1598914652251-87ec8fcda336?auto=format&fit=crop&q=80&w=600" alt="Cafe des Delices" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-4 left-4 text-white font-title-md text-title-md text-sm">Café des Délices</div>
                </div>
            </div>
        </div>
    </div>

    {# Key Features Bar #}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop mb-12">
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-container p-6 flex flex-wrap md:flex-nowrap items-center justify-between gap-6">
            <div class="flex items-center gap-4 w-full md:w-auto">
                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">schedule</span>
                </div>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-0.5">Durée</div>
                    <div class="font-title-md text-title-md text-on-surface">1 Journée (8h30-17h)</div>
                </div>
            </div>
            <div class="hidden md:block w-px h-12 bg-surface-container"></div>
            <div class="flex items-center gap-4 w-full md:w-auto">
                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">directions_car</span>
                </div>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-0.5">Transport</div>
                    <div class="font-title-md text-title-md text-on-surface">Privé & Climatisé</div>
                </div>
            </div>
            <div class="hidden md:block w-px h-12 bg-surface-container"></div>
            <div class="flex items-center gap-4 w-full md:w-auto">
                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">hotel</span>
                </div>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-0.5">Prise en charge</div>
                    <div class="font-title-md text-title-md text-on-surface">Directe à votre hôtel</div>
                </div>
            </div>
            <div class="hidden md:block w-px h-12 bg-surface-container"></div>
            <div class="flex items-center gap-4 w-full md:w-auto">
                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">verified_user</span>
                </div>
                <div>
                    <div class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-0.5">Annulation</div>
                    <div class="font-title-md text-title-md text-on-surface">100% Gratuite à 24h</div>
                </div>
            </div>
        </div>
    </div>

    {# Main Content & Sidebar #}
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop pb-24">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            {# Left Column #}
            <div class="lg:col-span-2 flex flex-col gap-12">
                
                {# Ce que vous allez vivre #}
                <section>
                    <div class="flex items-center gap-3 mb-6">
                        <span class="material-symbols-outlined text-primary text-[28px]">explore</span>
                        <h2 class="font-headline-md text-headline-md text-on-surface">Ce que vous allez vivre</h2>
                    </div>
                    <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 leading-relaxed">
                        Partez pour une journée exclusive au cœur des joyaux côtiers de Tunis. Accompagné de votre chauffeur privé dédié, découvrez les vestiges archéologiques grandioses de l'antique Carthage puis laissez-vous charmer par les ruelles pavées, les façades blanches et les volets bleus emblématiques de Sidi Bou Saïd avec un splendide panorama sur la Méditerranée.
                    </p>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="bg-surface-container-low rounded-xl p-4 text-center flex flex-col items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[24px]">account_balance</span>
                            <div>
                                <div class="font-label-md text-label-md text-on-surface">Carthage & Byrsa</div>
                                <div class="font-body-sm text-body-sm text-on-surface-variant">Histoire millénaire</div>
                            </div>
                        </div>
                        <div class="bg-surface-container-low rounded-xl p-4 text-center flex flex-col items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[24px]">holiday_village</span>
                            <div>
                                <div class="font-label-md text-label-md text-on-surface">Sidi Bou Saïd</div>
                                <div class="font-body-sm text-body-sm text-on-surface-variant">Village des artistes</div>
                            </div>
                        </div>
                        <div class="bg-surface-container-low rounded-xl p-4 text-center flex flex-col items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[24px]">landscape</span>
                            <div>
                                <div class="font-label-md text-label-md text-on-surface">Panorama Golfe</div>
                                <div class="font-body-sm text-body-sm text-on-surface-variant">Vue spectaculaire</div>
                            </div>
                        </div>
                        <div class="bg-surface-container-low rounded-xl p-4 text-center flex flex-col items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[24px]">local_cafe</span>
                            <div>
                                <div class="font-label-md text-label-md text-on-surface">Café des Délices</div>
                                <div class="font-body-sm text-body-sm text-on-surface-variant">Pause détente</div>
                            </div>
                        </div>
                    </div>
                </section>

                {# Programme de la Journée #}
                <section>
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-[28px]">map</span>
                            <h2 class="font-headline-md text-headline-md text-on-surface">Programme de la Journée</h2>
                        </div>
                        <span class="px-3 py-1.5 rounded-md bg-surface-container-high text-primary font-label-md text-label-md self-start md:self-auto">Rythme libre & sans stress</span>
                    </div>
                    
                    <div class="relative pl-6 md:pl-8 border-l-2 border-surface-container space-y-10 ml-4">
                        <div class="relative">
                            <div class="absolute -left-[43px] md:-left-[51px] w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm ring-4 ring-surface">1</div>
                            <h3 class="font-title-md text-title-md text-on-surface mb-2">08:30 — Prise en charge à votre hébergement</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant">Départ depuis votre hôtel, villa ou aéroport avec chauffeur privé et véhicule climatisé avec eau fraîche.</p>
                        </div>
                        <div class="relative">
                            <div class="absolute -left-[43px] md:-left-[51px] w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm ring-4 ring-surface">2</div>
                            <h3 class="font-title-md text-title-md text-on-surface mb-2">09:30 — Visite de Carthage Antique & Thermes d'Antonin</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant">Exploration des vestiges romains et puniques majeurs, de la colline sacrée de Byrsa et des ports puniques.</p>
                        </div>
                        <div class="relative">
                            <div class="absolute -left-[43px] md:-left-[51px] w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm ring-4 ring-surface">3</div>
                            <h3 class="font-title-md text-title-md text-on-surface mb-2">12:00 — Découverte de Sidi Bou Saïd & Déjeuner libre</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant">Promenade dans les allées blanches et bleues, pause thé aux pignons au célèbre Café des Délices et repas selon vos envies.</p>
                        </div>
                        <div class="relative">
                            <div class="absolute -left-[43px] md:-left-[51px] w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm ring-4 ring-surface">4</div>
                            <h3 class="font-title-md text-title-md text-on-surface mb-2">17:00 — Retour serein à votre adresse de départ</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant">Votre chauffeur vous raccompagne à votre point de départ en toute sérénité.</p>
                        </div>
                    </div>
                </section>

                {# Inclus / Non Inclus #}
                <section>
                    <h2 class="font-headline-md text-headline-md text-on-surface mb-6">Ce qui est inclus dans le tarif</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-surface-container-low rounded-2xl p-6">
                            <div class="flex items-center gap-2 mb-4 text-green-700 font-title-md text-title-md">
                                <span class="material-symbols-outlined">check_circle</span>
                                Inclus d'office
                            </div>
                            <ul class="space-y-3">
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-green-600 text-[20px] shrink-0">check</span>
                                    Véhicule privé climatisé (berline ou van)
                                </li>
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-green-600 text-[20px] shrink-0">check</span>
                                    Chauffeur professionnel bilingue dédié
                                </li>
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-green-600 text-[20px] shrink-0">check</span>
                                    Prise en charge et retour hôtel à Tunis / Côtes
                                </li>
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-green-600 text-[20px] shrink-0">check</span>
                                    Carburant, péages et bouteilles d'eau fraîches
                                </li>
                            </ul>
                        </div>
                        <div class="bg-surface-container-high/50 rounded-2xl p-6 border border-surface-container">
                            <div class="flex items-center gap-2 mb-4 text-error font-title-md text-title-md">
                                <span class="material-symbols-outlined">cancel</span>
                                Non inclus
                            </div>
                            <ul class="space-y-3">
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-outline text-[20px] shrink-0">close</span>
                                    Billets des sites archéologiques (~20 DT / pers.)
                                </li>
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-outline text-[20px] shrink-0">close</span>
                                    Déjeuner et consommations personnelles
                                </li>
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-outline text-[20px] shrink-0">close</span>
                                    Guide conférencier dédié (disponible en option)
                                </li>
                                <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
                                    <span class="material-symbols-outlined text-outline text-[20px] shrink-0">close</span>
                                    Dépenses individuelles et pourboires
                                </li>
                            </ul>
                        </div>
                    </div>
                </section>

                {# Booking Form #}
                <section class="bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-container p-6 md:p-8">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="material-symbols-outlined text-primary text-[28px]">event_available</span>
                        <h2 class="font-headline-md text-headline-md text-on-surface">Formulaire de Réservation Direct</h2>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface-variant mb-8">Remplissez ces 3 étapes simples. Aucune carte bancaire requise aujourd'hui.</p>
                    
                    <form class="space-y-8">
                        {# Step 1 #}
                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm">1</div>
                                <h3 class="font-title-md text-title-md text-on-surface">Date et Participants</h3>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-surface-container-low p-4 rounded-xl">
                                <div>
                                    <label class="block font-label-md text-label-md text-on-surface-variant mb-2">Date souhaitée</label>
                                    <div class="relative">
                                        <input type="date" value="2026-11-09" class="w-full h-11 px-4 rounded-lg bg-surface-container-lowest border border-surface-container text-on-surface focus:ring-2 focus:ring-primary outline-none">
                                    </div>
                                </div>
                                <div>
                                    <label class="block font-label-md text-label-md text-on-surface-variant mb-2">Adultes (+12 ans)</label>
                                    <div class="flex items-center justify-between h-11 px-2 rounded-lg bg-surface-container-lowest border border-surface-container">
                                        <button type="button" class="w-8 h-8 rounded bg-surface-container-low text-primary flex items-center justify-center hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[18px]">remove</span></button>
                                        <span class="font-title-md text-on-surface">2</span>
                                        <button type="button" class="w-8 h-8 rounded bg-surface-container-low text-primary flex items-center justify-center hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[18px]">add</span></button>
                                    </div>
                                </div>
                                <div>
                                    <label class="block font-label-md text-label-md text-on-surface-variant mb-2">Enfants (-12 ans)</label>
                                    <div class="flex items-center justify-between h-11 px-2 rounded-lg bg-surface-container-lowest border border-surface-container">
                                        <button type="button" class="w-8 h-8 rounded bg-surface-container-low text-primary flex items-center justify-center hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[18px]">remove</span></button>
                                        <span class="font-title-md text-on-surface">0</span>
                                        <button type="button" class="w-8 h-8 rounded bg-surface-container-low text-primary flex items-center justify-center hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[18px]">add</span></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Step 2 #}
                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm">2</div>
                                <h3 class="font-title-md text-title-md text-on-surface">Lieu de Prise en Charge</h3>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-surface-container-low p-4 rounded-xl">
                                <div>
                                    <label class="block font-label-md text-label-md text-on-surface-variant mb-2">Région de départ</label>
                                    <select class="w-full h-11 px-4 rounded-lg bg-surface-container-lowest border border-surface-container text-on-surface focus:ring-2 focus:ring-primary outline-none">
                                        <option>Tunis Centre, Médina, Berges du Lac (Inclus)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block font-label-md text-label-md text-on-surface-variant mb-2">Hôtel ou Adresse précise</label>
                                    <input type="text" placeholder="Ex: Hôtel Africa Tunis ou Résidence Gammarth" class="w-full h-11 px-4 rounded-lg bg-surface-container-lowest border border-surface-container text-on-surface focus:ring-2 focus:ring-primary outline-none">
                                </div>
                            </div>
                        </div>

                        {# Step 3 #}
                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm">3</div>
                                <h3 class="font-title-md text-title-md text-on-surface">Coordonnées du Contact</h3>
                            </div>
