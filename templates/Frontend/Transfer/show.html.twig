        <div class="mt-12 pt-8 border-t border-surface-container-high grid grid-cols-1 sm:grid-cols-3 gap-6"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary shrink-0"><span class="material-symbols-outlined text-[20px]">flight_takeoff</span></div><div><h4 class="text-xs font-bold">{{ 'transfer.form.flight_tracking_feature'|trans }}</h4><p class="text-[11px] text-on-surface-variant">{{ 'transfer.form.flight_tracking_feature_desc'|trans }}</p></div></div><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-tertiary/10 flex items-center justify-center text-tertiary shrink-0"><span class="material-symbols-outlined text-[20px]">shield</span></div><div><h4 class="text-xs font-bold">{{ 'transfer.form.payment_feature'|trans }}</h4><p class="text-[11px] text-on-surface-variant">{{ 'transfer.form.payment_feature_desc'|trans }}</p></div></div><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-secondary/10 flex items-center justify-center text-secondary shrink-0"><span class="material-symbols-outlined text-[20px]">timer</span></div><div><h4 class="text-xs font-bold">{{ 'transfer.form.cancellation_feature'|trans }}</h4><p class="text-[11px] text-on-surface-variant">{{ 'transfer.form.cancellation_feature_desc'|trans }}</p></div></div></div>
    </div>
