{% extends 'baseFront.html.twig' %}

{% block title %}{{ article.getTitleTranslated(locale) ?: 'Article du blog' }} - Yassmine Guide{% endblock %}

{% block stylesheets %}
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="{{ asset('assetsFront/js/tailwind.config.js') }}"></script>
{% endblock %}

{% block body_class %}bg-surface text-on-surface antialiased{% endblock %}

{% block body %}
    {% include 'Frontend/Components/_navbar.html.twig' %}

    <main class="w-full pt-20 bg-surface min-h-screen">
        <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-4 border-b border-surface-container">
            <nav class="flex flex-wrap items-center gap-2 font-label-md text-label-md text-on-surface-variant">
                <a href="{{ path('app_home') }}" class="hover:text-primary transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">home</span>
                    Accueil
                </a>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                <a href="{{ path('app_blog_index', {'_locale': locale}) }}" class="hover:text-primary transition-colors">Blog</a>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                <span class="text-on-surface font-semibold">{{ article.getTitleTranslated(locale) }}</span>
            </nav>
        </div>

        <article class="max-w-5xl mx-auto px-margin-mobile md:px-margin-desktop py-10 md:py-14">
            <div class="mb-8">
                {% set category = article.categories|first %}
                {% if category %}
                    <span class="inline-flex px-3 py-1.5 rounded-md bg-tertiary-container text-on-tertiary-container font-label-md text-label-md">
                        {{ category.getNameTranslated(locale) ?: category.getNameTranslated('fr') }}
                    </span>
                {% endif %}
            </div>

            <h1 class="font-display-mobile md:font-display text-display-mobile md:text-display text-on-surface mb-6">{{ article.getTitleTranslated(locale) }}</h1>

            <div class="flex flex-wrap items-center gap-4 mb-8 text-on-surface-variant font-body-md text-body-md">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">person</span>
                    <span>{{ article.authorName ?: 'Tunisia Mobility' }}</span>
                </div>
                <span>•</span>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                    <span>{{ article.publishedAt ? article.publishedAt|date('d M Y') : article.createdAt|date('d M Y') }}</span>
                </div>
                <span>•</span>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">schedule</span>
                    <span>{{ article.readTime }} min de lecture</span>
                </div>
            </div>

            {% if article.image %}
                <div class="overflow-hidden rounded-3xl mb-10">
                    <img src="{{ article.image }}" alt="{{ article.imageAlt ?: article.getTitleTranslated(locale) }}" class="w-full h-[420px] md:h-[560px] object-cover">
                </div>
            {% endif %}

            <div class="prose prose-lg max-w-none text-on-surface leading-8">
                {{ article.getContentTranslated(locale)|raw }}
            </div>
        </article>

        {% if relatedArticles is not empty %}
            <section class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop pb-20">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="font-headline-md text-headline-md text-on-surface">Articles récents</h2>
                    <a href="{{ path('app_blog_index', {'_locale': locale}) }}" class="text-primary font-label-lg text-label-lg">Voir tous les articles</a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                    {% for related in relatedArticles %}
                        <article class="bg-surface-container-lowest rounded-2xl border border-surface-container overflow-hidden hover:shadow-md transition-shadow">
                            {% if related.image %}
                                <div class="h-60 overflow-hidden">
                                    <img src="{{ related.image }}" alt="{{ related.imageAlt ?: related.getTitleTranslated(locale) }}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700">
                                </div>
                            {% endif %}
                            <div class="p-6">
                                <div class="font-body-sm text-body-sm text-on-surface-variant mb-2">{{ related.publishedAt ? related.publishedAt|date('d M Y') : related.createdAt|date('d M Y') }}</div>
                                <h3 class="font-title-md text-title-md text-on-surface mb-3 line-clamp-2">{{ related.getTitleTranslated(locale) }}</h3>
                                <p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3">{{ related.getExcerptTranslated(locale) ?: 'Découvrez cet article pour en savoir plus.' }}</p>
                                <a href="{{ path('app_blog_show', {'_locale': locale, 'slug': related.slug}) }}" class="font-label-md text-label-md text-primary inline-flex items-center gap-1">
                                    Lire l'article <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% include 'Frontend/Components/_footer.html.twig' %}
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assetsFront/js/navbar.js') }}?v=2"></script>
{% endblock %}
