<header class="fixed top-0 w-full z-50 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(11,78,162,0.06)]">
    <div class="h-20 w-full px-margin-desktop flex items-center justify-between">
        <div class="flex items-center gap-3">
            <a href="{{ path('app_home_locale', {'_locale': app.request.locale}) }}" aria-label="{{ 'navbar.home'|trans }}" class="flex items-center gap-2 sm:gap-2.5 transition-transform hover:scale-[1.03]">
                <img alt="Yassmine Guide" class="h-10 sm:h-12 md:h-14 w-auto object-contain" src="{{ asset('assetsFront/images/logo-yassmine-guide.png') }}">
                <span class="navbar-brand-name font-bold leading-none text-base sm:text-xl md:text-2xl"><span class="navbar-brand-name-primary">Yassmine</span> <span class="navbar-brand-name-accent">Guide</span></span>
            </a>
        </div>
        <nav class="hidden xl:flex items-center gap-6" data-active-classes="text-primary font-title-md">
            <a aria-current="page" class="transition-colors text-primary font-title-md" href="{{ path('app_home_locale', {'_locale': app.request.locale}) }}">{{ 'navbar.home'|trans }}</a>
            <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors" href="{{ path('app_liste_excursion', {'_locale': app.request.locale}) }}">{{ 'navbar.excursions'|trans }}</a>
            <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors" href="#">{{ 'navbar.about'|trans }}</a>
            <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors" href="{{ path('app_contact_locale', {'_locale': app.request.locale}) }}">{{ 'navbar.contact'|trans }}</a>
            <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors" href="{{ path('app_blog_index', {'_locale': app.request.locale}) }}">Blog</a>
        </nav>
        <div class="flex items-center gap-4">
            <div class="relative" data-navbar-dropdown>
                <button aria-expanded="false" aria-haspopup="true" class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container-high transition-colors font-label-md text-label-md text-on-surface-variant" data-navbar-dropdown-toggle type="button">
                    <span class="font-semibold text-on-surface">{{ app.request.locale|upper }}</span>
                    <span class="material-symbols-outlined text-[16px]">expand_more</span>
                </button>
                <div class="absolute right-0 mt-2 w-36 py-2 bg-surface-container-lowest rounded-xl shadow-[0_10px_25px_-5px_rgba(11,78,162,0.12)] opacity-0 pointer-events-none transition-all flex flex-col z-50" data-navbar-dropdown-menu>
                    {% set currentRoute = app.request.attributes.get('_route')|default('') %}
                    {% set currentSlug = app.request.attributes.get('slug')|default('') %}
                    {% set currentRouteParams = app.request.attributes.get('_route_params')|default({}) %}
                    {% set frLanguageUrl = path('app_home_locale', {'_locale': 'fr'}) %}
                    {% set enLanguageUrl = path('app_home_locale', {'_locale': 'en'}) %}
                    {% if currentRoute == 'app_detail_excursion' and currentSlug %}
                        {% set frLanguageUrl = path('app_detail_excursion', {'_locale': 'fr', 'slug': currentSlug}) %}
                        {% set enLanguageUrl = path('app_detail_excursion', {'_locale': 'en', 'slug': currentSlug}) %}
                    {% elseif currentRoute starts with 'app_transfert_show' or currentRoute starts with 'app_transfer_show' %}
                        {% set transferRoute = currentRoute starts with 'app_transfer_show' ? 'app_transfer_show_locale' : 'app_transfert_show_locale' %}
                        {% set frLanguageUrl = path(transferRoute, {'_locale': 'fr', 'slug': currentSlug}) %}
                        {% set enLanguageUrl = path(transferRoute, {'_locale': 'en', 'slug': currentSlug}) %}
                    {% elseif currentRoute == 'app_liste_excursion' %}
                        {% set frLanguageUrl = path('app_liste_excursion', currentRouteParams|merge({'_locale': 'fr'})) %}
                        {% set enLanguageUrl = path('app_liste_excursion', currentRouteParams|merge({'_locale': 'en'})) %}
                    {% elseif currentRoute starts with 'app_contact' %}
                        {% set frLanguageUrl = path('app_contact_locale', {'_locale': 'fr'}) %}
                        {% set enLanguageUrl = path('app_contact_locale', {'_locale': 'en'}) %}
                    {% elseif currentRoute == 'app_blog_index' %}
                        {% set frLanguageUrl = path('app_blog_index', {'_locale': 'fr'}) %}
                        {% set enLanguageUrl = path('app_blog_index', {'_locale': 'en'}) %}
                    {% elseif currentRoute == 'app_blog_show' and currentSlug %}
                        {% set frLanguageUrl = path('app_blog_show', {'_locale': 'fr', 'slug': currentSlug}) %}
                        {% set enLanguageUrl = path('app_blog_show', {'_locale': 'en', 'slug': currentSlug}) %}
                    {% endif %}
                    <a href="{{ frLanguageUrl }}" class="flex items-center gap-2.5 px-4 py-2 font-label-md text-label-md {{ app.request.locale == 'fr' ? 'text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface' }} transition-colors w-full text-left">
                        <span class="">🇫🇷</span><span class="">Français</span>
                    </a>
                    <a href="{{ enLanguageUrl }}" class="flex items-center gap-2.5 px-4 py-2 font-label-md text-label-md {{ app.request.locale == 'en' ? 'text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface' }} transition-colors w-full text-left">
                        <span class="">🇬🇧</span><span class="">English</span>
                    </a>
                </div>
            </div>
            <div class="relative" data-navbar-dropdown>
                <button aria-expanded="false" aria-haspopup="true" class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container-high transition-colors font-label-md text-label-md text-on-surface-variant" data-navbar-dropdown-toggle type="button">
                    <span class="font-semibold text-on-surface" data-navbar-currency-label>{{ current_currency().symbol }}</span>
                    <span class="material-symbols-outlined text-[16px]">expand_more</span>
                </button>
                <div class="absolute right-0 mt-2 w-32 py-2 bg-surface-container-lowest rounded-xl shadow-[0_10px_25px_-5px_rgba(11,78,162,0.12)] opacity-0 pointer-events-none transition-all flex flex-col z-50" data-navbar-dropdown-menu>
                    {% for currency in currency_options() %}
                        <button data-currency-code="{{ currency.code }}" data-currency-rate="{{ currency.rate }}" data-currency-symbol="{{ currency.symbol }}" data-currency-position="{{ currency.code == 'USD' ? 'prefix' : 'suffix' }}" data-currency-selected="{{ currency.code == current_currency().code ? 'true' : 'false' }}" data-currency-url="{{ path('app_currency_set', {code: currency.code}) }}" class="flex items-center justify-between px-4 py-2 font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface transition-colors w-full text-left" type="button">
                            <span>{{ currency.code }}</span><span class="text-outline font-normal">{{ currency.symbol }}</span>
                        </button>
                    {% endfor %}
                </div>
            </div>
            {% if app.user %}
                <div class="relative" data-user-menu>
                    <button aria-expanded="false" aria-haspopup="true" aria-label="{{ 'auth.account'|trans }}" class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shadow-sm hover:scale-105 transition-transform" data-user-menu-toggle type="button">
                        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                    </button>
                    <div class="auth-user-menu" data-user-menu-panel hidden>
                        <a href="{{ path('app_profile') }}">{{ 'auth.profile'|trans }}</a>
                        <a href="{{ path('admin_transfere_index') }}">Admin</a>
                        <a href="{{ logout_path() }}">{{ 'auth.logout'|trans }}</a>
                    </div>
                </div>
            {% else %}
                <button class="auth-connect-button" data-auth-open="login" type="button">{{ 'auth.connect'|trans }}</button>
            {% endif %}
        </div>
    </div>
</header>
