{% extends 'Backend/base.html.twig' %}

{% block title %}Nouveau message - Admin{% endblock %}

{% block header_title %}Nouveau message{% endblock %}

{% block body %}
<div class="compose-message-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Nouveau message</h1>
            <p class="page-header-description">Rédigez un e-mail à destination de n’importe quelle adresse.</p>
        </div>
        <div class="page-actions">
            <a href="{{ path('admin_contact_index') }}" class="btn btn-secondary">Annuler</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for flashMessage in messages %}
            <div class="alert {{ label == 'error' ? 'alert-error' : (label == 'warning' ? 'alert-warning' : 'alert-success') }}" role="status">
                {{ flashMessage }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card compose-message-card">
        <div class="card-body">
            {{ form_start(form, {'attr': {'id': 'newContactMessageForm', 'data-disable-submit-once': 'true'}}) }}
            {{ form_errors(form) }}

            <div class="compose-message-fields">
                <div class="form-group">
                    {{ form_label(form.recipient, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.recipient, {'attr': {'class': 'form-control', 'autocomplete': 'email', 'list': 'contact-recipient-suggestions', 'placeholder': 'nom@exemple.com'}}) }}
                    <datalist id="contact-recipient-suggestions">
                        {% for recipient in recipientSuggestions %}
                            <option value="{{ recipient }}">
                        {% endfor %}
                    </datalist>
                    {{ form_errors(form.recipient) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.recipientName, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.recipientName, {'attr': {'class': 'form-control', 'autocomplete': 'name', 'placeholder': 'Facultatif'}}) }}
                    {{ form_errors(form.recipientName) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.subject, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.subject, {'attr': {'class': 'form-control', 'placeholder': 'Sujet de votre e-mail'}}) }}
                    {{ form_errors(form.subject) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.body, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.body, {'attr': {'class': 'form-control compose-message-body', 'rows': 14, 'placeholder': 'Rédigez votre message…'}}) }}
                    {{ form_errors(form.body) }}
                </div>
            </div>

            <div class="form-actions compose-message-actions">
                <a href="{{ path('admin_contact_index') }}" class="btn btn-secondary">Annuler</a>
                <button type="submit" class="btn btn-primary">✉️ Envoyer le message</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
