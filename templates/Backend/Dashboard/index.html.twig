{% extends 'Backend/base.html.twig' %}

{% block title %}Dashboard - Admin{% endblock %}

{% block header_title %}Dashboard{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <span class="dashboard-eyebrow">ESPACE DE PILOTAGE</span>
        <h1 class="page-title">Bonjour, {{ app.user ? app.user.email|split('@')[0]|capitalize : 'Admin' }} <span aria-hidden="true">✦</span></h1>
        <p class="page-header-description">Voici ce qui se passe sur votre plateforme aujourd'hui.</p>
    </div>
    <div class="dashboard-date"><span class="dashboard-live-dot"></span> Vue d'ensemble · {{ 'now'|date('d/m/Y') }}</div>
</div>

<div class="stats-grid">
    <a href="{{ path('admin_transfere_index') }}" class="stats-card clickable">
        <div class="stats-card-icon primary">
            <span>🚐</span>
        </div>
        <div class="stats-card-value">{{ stats.transferts.total }}</div>
        <div class="stats-card-label">Transferts</div>
        <div class="stats-card-description">{{ stats.transferts.actifs }} actifs • {{ stats.transferts.inactifs }} inactifs</div>
    </a>

    <a href="{{ path('admin_saison_index') }}" class="stats-card clickable">
        <div class="stats-card-icon success">
            <span>📆</span>
        </div>
        <div class="stats-card-value">{{ stats.saisons.total }}</div>
        <div class="stats-card-label">Saisons</div>
        <div class="stats-card-description">{{ stats.saisons.active }} saison active</div>
    </a>

    <a href="{{ path('admin_currency_index') }}" class="stats-card clickable">
        <div class="stats-card-icon warning">
            <span>💰</span>
        </div>
        <div class="stats-card-value">{{ stats.devises.total }}</div>
        <div class="stats-card-label">Devises</div>
        <div class="stats-card-description">Taux de change configurés</div>
    </a>

    <a href="{{ path('admin_contact_index') }}" class="stats-card clickable">
        <div class="stats-card-icon info">
            <span>📧</span>
        </div>
        <div class="stats-card-value">{{ stats.contacts.total }}</div>
        <div class="stats-card-label">Contacts</div>
        <div class="stats-card-description">Messages reçus</div>
    </a>

    <a href="{{ path('admin_reservation_index') }}" class="stats-card clickable">
        <div class="stats-card-icon primary">
            <span>📋</span>
        </div>
        <div class="stats-card-value">{{ stats.reservations.total }}</div>
        <div class="stats-card-label">Réservations</div>
        <div class="stats-card-description">{{ stats.reservations.pending }} en attente • {{ stats.reservations.confirmed }} confirmées</div>
    </a>
</div>

<div class="dashboard-lower-grid">
<div class="card dashboard-status-card">
    <div class="card-header">
        <div><span class="dashboard-section-kicker">SUIVI D'ACTIVITÉ</span><h3 class="card-title">État des réservations</h3></div>
        <a href="{{ path('admin_reservation_index') }}" class="dashboard-text-link">Voir les réservations <span aria-hidden="true">↗</span></a>
    </div>
    <div class="card-body">
        {% set reservationTotal = stats.reservations.pending + stats.reservations.confirmed + stats.reservations.cancelled %}
        <div class="reservation-breakdown">
            <div class="reservation-breakdown-head"><span>Répartition</span><strong>{{ reservationTotal }} <small>au total</small></strong></div>
            <div class="reservation-progress" aria-hidden="true">
                <span class="reservation-progress-pending" style="width: {{ reservationTotal > 0 ? (stats.reservations.pending / reservationTotal * 100) : 0 }}%"></span>
                <span class="reservation-progress-confirmed" style="width: {{ reservationTotal > 0 ? (stats.reservations.confirmed / reservationTotal * 100) : 0 }}%"></span>
                <span class="reservation-progress-cancelled" style="width: {{ reservationTotal > 0 ? (stats.reservations.cancelled / reservationTotal * 100) : 0 }}%"></span>
            </div>
            <div class="reservation-legend">
                <div><span class="reservation-legend-label"><i class="legend-dot pending"></i>En attente</span><strong>{{ stats.reservations.pending }}</strong></div>
                <div><span class="reservation-legend-label"><i class="legend-dot confirmed"></i>Confirmées</span><strong>{{ stats.reservations.confirmed }}</strong></div>
                <div><span class="reservation-legend-label"><i class="legend-dot cancelled"></i>Annulées</span><strong>{{ stats.reservations.cancelled }}</strong></div>
            </div>
        </div>
    </div>
</div>
<a href="{{ path('admin_contact_index') }}" class="dashboard-inbox-card">
    <span class="dashboard-inbox-icon" aria-hidden="true">✉</span>
    <span class="dashboard-inbox-copy"><span class="dashboard-section-kicker">À VOTRE ÉCOUTE</span><strong>Boîte de réception</strong><small>Consultez les messages de vos voyageurs.</small></span>
    <span class="dashboard-inbox-arrow" aria-hidden="true">↗</span>
</a>
</div>
{% endblock %}
