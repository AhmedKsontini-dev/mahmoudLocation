{% extends 'Backend/base.html.twig' %}

{% block title %}Catégories du blog - Admin{% endblock %}
{% block header_title %}Catégories du blog{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">Catégories du blog</h1>
        <p class="page-header-description">Gérez les catégories utilisées par les articles.</p>
    </div>
    <div class="page-actions">
        <a href="{{ path('admin_blog_category_new') }}" class="btn btn-primary">➕ Nouvelle catégorie</a>
    </div>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert {{ label == 'error' ? 'alert-error' : (label == 'warning' ? 'alert-warning' : 'alert-success') }}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<div class="card">
    <div class="card-body">
        <div class="table-container">
            <table class="table admin-data-table">
                <thead>
                    <tr>
                        <th>Nom (FR)</th>
                        <th>Slug</th>
                        <th>Position</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td><strong>{{ category.getNameTranslated('fr') ?? '-' }}</strong></td>
                            <td>{{ category.slug }}</td>
                            <td>{{ category.position }}</td>
                            <td>
                                {% if category.isActive %}
                                    <span class="badge badge-success">Active</span>
                                {% else %}
                                    <span class="badge badge-secondary">Inactive</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a href="{{ path('admin_blog_category_edit', {id: category.id}) }}" class="btn btn-sm btn-outline">✏️</a>
                                    <form method="post" action="{{ path('admin_blog_category_delete', {id: category.id}) }}" onsubmit="return confirm('Supprimer cette catégorie ?');" class="inline-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger">🗑️</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">
                                <div class="empty-state">
                                    <div class="empty-state-icon">📁</div>
                                    <div class="empty-state-title">Aucune catégorie</div>
                                    <div class="empty-state-text">Créez votre première catégorie pour organiser les articles.</div>
                                    <a href="{{ path('admin_blog_category_new') }}" class="btn btn-primary">Créer une catégorie</a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
