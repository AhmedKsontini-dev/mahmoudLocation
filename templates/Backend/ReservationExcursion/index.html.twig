{% extends 'Backend/base.html.twig' %}

{% block title %}Gestion des réservations d’excursions - Admin{% endblock %}

{% block header_title %}Réservations d'excursions{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assetsBack/css/reservation-excursion/index.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="reservation-excursion-index">
    {# En-tête de page #}
    <div class="page-header">
        <div>
            <h1 class="page-title">Gestion des réservations d’excursions</h1>
            <p class="page-header-description">Gérez, suivez et mettez à jour en temps réel les réservations d’excursions enregistrées.</p>
        </div>
    </div>

    {# Messages Flash de notification #}
    {% for label, messages in app.flashes %}
        {% for flashMessage in messages %}
            <div class="alert {{ label == 'error' ? 'alert-error' : (label == 'warning' ? 'alert-warning' : 'alert-success') }}" role="alert">
                <span class="alert-icon">{{ label == 'error' ? '⚠️' : (label == 'warning' ? '🔔' : '✓') }}</span>
                <span>{{ flashMessage }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    {# Cartes statistiques d'ensemble #}
    <div class="reservation-stats-grid">
        <div class="reservation-stat-card">
            <div class="reservation-stat-icon reservation-stat-icon--total" aria-hidden="true">🎫</div>
            <div class="reservation-stat-info">
                <span class="reservation-stat-label">Total réservations</span>
                <span class="reservation-stat-value">{{ stats.total }}</span>
            </div>
        </div>
        <div class="reservation-stat-card">
            <div class="reservation-stat-icon reservation-stat-icon--pending" aria-hidden="true">⏳</div>
            <div class="reservation-stat-info">
                <span class="reservation-stat-label">En attente</span>
                <span class="reservation-stat-value">{{ stats.pending }}</span>
            </div>
        </div>
        <div class="reservation-stat-card">
            <div class="reservation-stat-icon reservation-stat-icon--confirmed" aria-hidden="true">✅</div>
            <div class="reservation-stat-info">
                <span class="reservation-stat-label">Confirmées</span>
                <span class="reservation-stat-value">{{ stats.confirmed }}</span>
            </div>
        </div>
        <div class="reservation-stat-card">
            <div class="reservation-stat-icon reservation-stat-icon--cancelled" aria-hidden="true">❌</div>
            <div class="reservation-stat-info">
                <span class="reservation-stat-label">Annulées</span>
                <span class="reservation-stat-value">{{ stats.cancelled }}</span>
            </div>
        </div>
    </div>

    {# Panneau de recherche & filtres #}
    <div class="reservation-filter-panel">
        <form method="get" action="{{ path('admin_reservation_excursion_index') }}" class="reservation-filter-form" id="filterForm">
            {# Barre de recherche multi-critères #}
            <div class="filter-input-wrapper">
                <span class="filter-icon" aria-hidden="true">🔍</span>
                <input type="search"
                       name="search"
                       id="searchInput"
                       class="filter-input"
                       value="{{ search }}"
                       placeholder="Nom, prénom, email, WhatsApp, excursion..."
                       autocomplete="off"
                       aria-label="Rechercher une réservation d’excursion">
            </div>

            {# Filtre par statut #}
            <div>
                <select name="status" class="filter-select" aria-label="Filtrer par statut" onchange="this.form.submit()">
                    <option value="">Tous les statuts</option>
                    <option value="en_attente" {{ currentStatus == 'en_attente' ? 'selected' : '' }}>En attente</option>
                    <option value="confirmee" {{ currentStatus == 'confirmee' ? 'selected' : '' }}>Confirmée</option>
                    <option value="annulee" {{ currentStatus == 'annulee' ? 'selected' : '' }}>Annulée</option>
                </select>
            </div>

            {# Filtre par excursion #}
            <div>
                <select name="excursion" class="filter-select" aria-label="Filtrer par excursion" onchange="this.form.submit()">
                    <option value="">Toutes les excursions</option>
                    {% for exc in excursions %}
                        <option value="{{ exc.id }}" {{ currentExcursion == exc.id ? 'selected' : '' }}>
                            {{ exc.getTitleTranslated('fr') ?: exc.slug }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            {# Filtre par date début #}
            <div class="filter-date-group">
                <label for="dateFromInput" class="filter-date-label">Date début</label>
                <input type="date"
                       name="date_from"
                       id="dateFromInput"
                       class="filter-select"
                       value="{{ dateFrom }}"
                       title="Date début de l'excursion">
            </div>

            {# Filtre par date fin #}
            <div class="filter-date-group">
                <label for="dateToInput" class="filter-date-label">Date fin</label>
                <input type="date"
                       name="date_to"
                       id="dateToInput"
                       class="filter-select"
                       value="{{ dateTo }}"
                       title="Date fin de l'excursion">
            </div>

            {# Actions de filtrage #}
            <div class="filter-actions">
                <button type="submit" class="btn btn-primary" id="btnFilterSubmit">
                    Filtrer
                </button>
                {% if search is not empty or currentStatus is not empty or currentExcursion > 0 or dateFrom is not empty or dateTo is not empty %}
                    <a href="{{ path('admin_reservation_excursion_index') }}" class="filter-reset-link" title="Réinitialiser tous les filtres">
                        ✕ Réinitialiser
                    </a>
                {% endif %}
            </div>
        </form>
    </div>

    {# Carte principale : Tableau des réservations #}
    <div class="card" id="reservationCard">
        <div class="card-body" style="padding: 0;">
            <div class="table-container">
                <table class="table reservation-table admin-data-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Client</th>
                            <th>Excursion</th>
                            <th>Date de l’excursion</th>
                            <th>Participants</th>
                            <th style="width: 140px;">Statut</th>
                            <th style="width: 110px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for reservation in reservations %}
                            {% set exc = reservation.excursion %}
                            {% set mainImage = exc.images|filter(i => i.isMain)|first ?: exc.images|first %}
                            <tr id="reservation-row-{{ reservation.id }}">
                                <td>
                                    <span class="reservation-id-badge">#{{ reservation.id }}</span>
                                </td>
                                <td>
                                    <div class="client-name">{{ reservation.nom }} {{ reservation.prenom }}</div>
                                </td>
                                <td>
                                    <div class="excursion-tag">
                                        {% if mainImage and mainImage.imagePath %}
                                            <img src="{{ asset(mainImage.imagePath) }}" alt="" class="excursion-mini-thumb">
                                        {% else %}
                                            <span class="excursion-icon-fallback">🏝️</span>
                                        {% endif %}
                                        <div>
                                            <a href="{{ path('admin_reservation_excursion_show', {id: reservation.id}) }}" style="color: var(--res-ink); text-decoration: none; font-weight: 700;">
                                                {{ exc.getTitleTranslated('fr') ?: exc.slug }}
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-weight: 600;">
                                        📅 {{ reservation.dateExcursion ? reservation.dateExcursion|date('d/m/Y') : 'N/A' }}
                                    </div>
                                </td>
                                <td>
                                    <span class="participants-badge">
                                        👥 {{ reservation.nombreAdultes }} adulte{{ reservation.nombreAdultes > 1 ? 's' : '' }} ·
                                        {{ reservation.nombreEnfants }} enfant{{ reservation.nombreEnfants > 1 ? 's' : '' }}
                                    </span>
                                </td>
                                <td>
                                    {# Badge cliquable pour modifier le statut rapidement en AJAX #}
                                    <div class="dropdown status-dropdown" id="status-dropdown-{{ reservation.id }}">
                                        <button type="button"
                                                class="badge-clickable badge {{ reservation.statutBadgeClass }}"
                                                onclick="toggleDropdown(this)"
                                                aria-haspopup="true"
                                                aria-expanded="false"
                                                title="Cliquer pour changer le statut">
                                            <span class="status-label">{{ reservation.statutLabel }}</span>
                                            <span class="status-caret" aria-hidden="true">▾</span>
                                        </button>
                                        <div class="dropdown-menu status-dropdown-menu">
                                            <div class="status-menu-title">Changer le statut</div>
                                            <button type="button"
                                                    class="dropdown-item status-action-item {% if reservation.statut == 'confirmee' %}is-active{% endif %}"
                                                    data-status="confirmee"
                                                    onclick="updateReservationStatus({{ reservation.id }}, 'confirmee', '{{ csrf_token('status_' ~ reservation.id) }}', this)">
                                                <div class="status-action-item-left">
                                                    <span class="status-pill status-pill-confirmed"></span>
                                                    <span>Confirmer</span>
                                                </div>
                                                {% if reservation.statut == 'confirmee' %}<span class="status-check">✓</span>{% endif %}
                                            </button>
                                            <button type="button"
                                                    class="dropdown-item status-action-item text-danger {% if reservation.statut == 'annulee' %}is-active{% endif %}"
                                                    data-status="annulee"
                                                    onclick="updateReservationStatus({{ reservation.id }}, 'annulee', '{{ csrf_token('status_' ~ reservation.id) }}', this)">
                                                <div class="status-action-item-left">
                                                    <span class="status-pill status-pill-cancelled"></span>
                                                    <span>Annuler</span>
                                                </div>
                                                {% if reservation.statut == 'annulee' %}<span class="status-check">✓</span>{% endif %}
                                            </button>
                                        </div>
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    {# Menu déroulant compact Actions #}
                                    <div class="dropdown">
                                        <button type="button" class="btn btn-sm btn-outline dropdown-toggle" onclick="toggleDropdown(this)">Actions</button>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="{{ path('admin_reservation_excursion_show', {id: reservation.id}) }}">
                                                <span>👁️</span> Voir les détails
                                            </a>
                                            <a class="dropdown-item" href="{{ path('admin_reservation_excursion_edit', filterParams|merge({id: reservation.id, page: pagination.page})) }}">
                                                <span>✏️</span> Modifier
                                            </a>
                                            <div class="dropdown-divider"></div>
                                            <button type="button"
                                                    class="dropdown-item text-danger btn-delete-reservation"
                                                    onclick="openDeleteModal({{ reservation.id }}, '{{ reservation.nomComplet|e('js') }}', '{{ (exc.getTitleTranslated('fr') ?: exc.slug)|e('js') }}', '{{ path('admin_reservation_excursion_delete', {id: reservation.id}) }}', '{{ csrf_token('delete' ~ reservation.id) }}')">
                                                <span>🗑️</span> Supprimer
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center" style="padding: 3.5rem 1.5rem;">
                                    <div class="empty-state">
                                        <div class="empty-state-icon" style="font-size: 2.75rem; margin-bottom: 0.5rem;">🏝️</div>
                                        {% if search is not empty or currentStatus is not empty or currentExcursion > 0 or dateFrom is not empty or dateTo is not empty %}
                                            <div class="empty-state-title" style="font-weight: 700; font-size: 1.15rem; color: var(--res-ink);">
                                                Aucune réservation d’excursion trouvée
                                            </div>
                                            <div class="empty-state-text" style="color: var(--res-muted); margin-top: 0.35rem; max-width: 480px; margin-left: auto; margin-right: auto;">
                                                Aucun résultat ne correspond à vos filtres actuels. Modifiez vos critères ou réinitialisez les filtres.
                                            </div>
                                            <div style="margin-top: 1.25rem;">
                                                <a href="{{ path('admin_reservation_excursion_index') }}" class="btn btn-secondary btn-sm">
                                                    Effacer tous les filtres
                                                </a>
                                            </div>
                                        {% else %}
                                            <div class="empty-state-title" style="font-weight: 700; font-size: 1.15rem; color: var(--res-ink);">
                                                Aucune réservation d’excursion
                                            </div>
                                            <div class="empty-state-text" style="color: var(--res-muted); margin-top: 0.35rem;">
                                                Aucune réservation d’excursion n’a encore été enregistrée dans la base de données.
                                            </div>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Barre de pagination et résumé #}
            {% if pagination.total > 0 %}
                <div class="reservation-pagination-footer">
                    <div class="reservation-table-count">
                        {% set startItem = ((pagination.page - 1) * pagination.limit) + 1 %}
                        {% set endItem = min(pagination.page * pagination.limit, pagination.total) %}
                        Affichage de <strong>{{ startItem }}</strong> à <strong>{{ endItem }}</strong> sur <strong>{{ pagination.total }}</strong> réservation{{ pagination.total > 1 ? 's' : '' }}
                        {% if search is not empty %}
                            <span class="search-indicator-tag">(recherche : « {{ search }} »)</span>
                        {% endif %}
                        {% if currentStatus is not empty %}
                            <span class="search-indicator-tag">
                                (statut : {{ currentStatus == 'en_attente' ? 'en attente' : (currentStatus == 'confirmee' ? 'confirmée' : 'annulée') }})
                            </span>
                        {% endif %}
                    </div>

                    {% if pagination.pages > 1 %}
                        <nav class="pagination-nav" aria-label="Pagination des réservations d’excursions">
                            <ul class="pagination-list">
                                {# Bouton Précédent #}
                                <li class="pagination-item">
                                    {% if pagination.page > 1 %}
                                        <a href="{{ path('admin_reservation_excursion_index', filterParams|merge({page: pagination.page - 1})) }}"
                                           class="pagination-link"
                                           aria-label="Page précédente">
                                            ‹ Précédent
                                        </a>
                                    {% else %}
                                        <span class="pagination-link pagination-link--disabled">‹ Précédent</span>
                                    {% endif %}
                                </li>

                                {# Numérotation des pages #}
                                {% set maxPagesToShow = 7 %}
                                {% if pagination.pages <= maxPagesToShow %}
                                    {% for p in 1..pagination.pages %}
                                        <li class="pagination-item">
                                            {% if p == pagination.page %}
                                                <span class="pagination-link active" aria-current="page">{{ p }}</span>
                                            {% else %}
                                                <a href="{{ path('admin_reservation_excursion_index', filterParams|merge({page: p})) }}" class="pagination-link">{{ p }}</a>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                {% else %}
                                    {# Première page #}
                                    <li class="pagination-item">
                                        {% if pagination.page == 1 %}
                                            <span class="pagination-link active" aria-current="page">1</span>
                                        {% else %}
                                            <a href="{{ path('admin_reservation_excursion_index', filterParams|merge({page: 1})) }}" class="pagination-link">1</a>
                                        {% endif %}
                                    </li>

                                    {% if pagination.page > 3 %}
                                        <li class="pagination-item"><span class="pagination-ellipsis">…</span></li>
                                    {% endif %}

                                    {% set startMiddle = max(2, pagination.page - 1) %}
                                    {% set endMiddle = min(pagination.pages - 1, pagination.page + 1) %}
                                    {% for p in startMiddle..endMiddle %}
                                        <li class="pagination-item">
                                            {% if p == pagination.page %}
                                                <span class="pagination-link active" aria-current="page">{{ p }}</span>
                                            {% else %}
                                                <a href="{{ path('admin_reservation_excursion_index', filterParams|merge({page: p})) }}" class="pagination-link">{{ p }}</a>
                                            {% endif %}
                                        </li>
                                    {% endfor %}

                                    {% if pagination.page < pagination.pages - 2 %}
                                        <li class="pagination-item"><span class="pagination-ellipsis">…</span></li>
                                    {% endif %}

                                    {# Dernière page #}
                                    <li class="pagination-item">
                                        {% if pagination.page == pagination.pages %}
                                            <span class="pagination-link active" aria-current="page">{{ pagination.pages }}</span>
                                        {% else %}
                                            <a href="{{ path('admin_reservation_excursion_index', filterParams|merge({page: pagination.pages})) }}" class="pagination-link">{{ pagination.pages }}</a>
                                        {% endif %}
                                    </li>
                                {% endif %}

                                {# Bouton Suivant #}
                                <li class="pagination-item">
                                    {% if pagination.page < pagination.pages %}
                                        <a href="{{ path('admin_reservation_excursion_index', filterParams|merge({page: pagination.page + 1})) }}"
                                           class="pagination-link"
                                           aria-label="Page suivante">
                                            Suivant ›
                                        </a>
                                    {% else %}
                                        <span class="pagination-link pagination-link--disabled">Suivant ›</span>
                                    {% endif %}
                                </li>
                            </ul>
                        </nav>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

{# Modale de confirmation avant suppression #}
<div class="admin-modal-overlay" id="deleteModalOverlay" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
    <div class="admin-modal">
        <div class="admin-modal-header">
            <div class="admin-modal-icon-danger" aria-hidden="true">🗑️</div>
            <h3 class="admin-modal-title" id="deleteModalTitle">Confirmer la suppression</h3>
        </div>
        <div class="admin-modal-body">
            <p style="margin: 0 0 0.5rem; font-weight: 600; color: #1e293b;">
                Êtes-vous sûr de vouloir supprimer cette réservation ? Cette action est irréversible.
            </p>
            <p style="margin: 0; color: var(--res-muted); font-size: 0.85rem;">
                La réservation sera définitivement effacée. L'excursion associée ne sera pas supprimée.
            </p>
            <div class="admin-modal-recap">
                <div class="admin-modal-recap-row">
                    <span style="color: var(--res-muted);">Client :</span>
                    <strong id="modalClientName">-</strong>
                </div>
                <div class="admin-modal-recap-row">
                    <span style="color: var(--res-muted);">Excursion :</span>
                    <strong id="modalExcursionTitle">-</strong>
                </div>
                <div class="admin-modal-recap-row">
                    <span style="color: var(--res-muted);">Référence :</span>
                    <strong id="modalReservationId">-</strong>
                </div>
            </div>
        </div>
        <div class="admin-modal-footer">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">Annuler</button>
            <form id="deleteForm" method="post" action="" style="margin: 0;">
                <input type="hidden" name="_token" id="deleteCsrfToken" value="">
                {% for key, val in filterParams %}
                    <input type="hidden" name="{{ key }}" value="{{ val }}">
                {% endfor %}
                <input type="hidden" name="page" value="{{ pagination.page }}">
                <button type="submit" class="btn btn-danger">Supprimer définitivement</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // ── Dropdown Engine avec positionnement dynamique ──
        (function () {
            var _activeMenu = null;
            var _activeBtn  = null;

            function positionMenu(menu, btn) {
                var rect = btn.getBoundingClientRect();
                menu.style.top   = '-9999px';
                menu.style.left  = '-9999px';
                menu.style.right = 'auto';
                menu.style.bottom = 'auto';

                var menuW = menu.offsetWidth;
                var menuH = menu.offsetHeight;
                var spaceBelow = window.innerHeight - rect.bottom;
                var spaceAbove = rect.top;

                var left = Math.max(4, Math.min(rect.right - menuW, window.innerWidth - menuW - 4));

                var top;
                if (spaceBelow >= menuH + 6 || spaceBelow >= spaceAbove) {
                    top = rect.bottom + 4;
                } else if (spaceAbove >= menuH + 6) {
                    top = rect.top - menuH - 4;
                } else {
                    top = Math.max(4, window.innerHeight - menuH - 4);
                }

                menu.style.left = left + 'px';
                menu.style.top  = top  + 'px';
            }

            function closeFixedMenus(except) {
                document.querySelectorAll('.dropdown-menu.dropdown-menu--fixed-open').forEach(function (m) {
                    if (m !== except) {
                        var owner = m._dropdownOwner;
                        m.classList.remove('dropdown-menu--fixed-open');
                        m.style.cssText = '';
                        if (owner) {
                            owner.appendChild(m);
                            owner.classList.remove('open');
                            m._dropdownOwner = null;
                        }
                    }
                });
                if (!except) { _activeMenu = null; _activeBtn = null; }
            }

            window.toggleDropdown = function (btn) {
                var dropdown = btn.closest('.dropdown');
                var wasOpen  = dropdown.classList.contains('open');

                closeFixedMenus(null);
                if (wasOpen) return;

                var menu = dropdown.querySelector('.dropdown-menu');
                if (!menu) return;

                menu._dropdownOwner = dropdown;
                document.body.appendChild(menu);
                menu.style.position = 'fixed';
                menu.style.zIndex   = '99999';
                menu.style.margin   = '0';
                menu.style.display  = 'block';
                menu.classList.add('dropdown-menu--fixed-open');
                dropdown.classList.add('open');
                positionMenu(menu, btn);
                _activeMenu = menu;
                _activeBtn  = btn;
            };

            function reposition() {
                if (_activeMenu && _activeBtn) positionMenu(_activeMenu, _activeBtn);
            }
            window.addEventListener('scroll', reposition, true);
            window.addEventListener('resize', reposition);
            window.closeAdminDropdownMenus = function() {
                closeFixedMenus(null);
            };

            document.addEventListener('click', function (e) {
                if (!e.target.closest('.dropdown') && !e.target.closest('.dropdown-menu--fixed-open')) {
                    closeFixedMenus(null);
                }
            }, true);
        })();

        // ── Mise à jour rapide du statut par requête AJAX sécurisée ──
        function updateReservationStatus(id, newStatus, token, itemBtn) {
            var dropdown = document.getElementById('status-dropdown-' + id);
            var badgeBtn = dropdown.querySelector('.badge-clickable');
            var labelSpan = badgeBtn.querySelector('.status-label');
            var oldText = labelSpan.textContent;

            badgeBtn.style.opacity = '0.6';
            badgeBtn.style.pointerEvents = 'none';

            var formData = new FormData();
            formData.append('status', newStatus);
            formData.append('_token', token);

            fetch('{{ path('admin_reservation_excursion_index') }}/' + id + '/status', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: formData
            })
            .then(function(response) {
                return response.json().then(function(data) {
                    if (!response.ok) {
                        throw new Error(data.message || 'Erreur lors de la mise à jour du statut.');
                    }
                    return data;
                });
            })
            .then(function(data) {
                badgeBtn.style.opacity = '1';
                badgeBtn.style.pointerEvents = '';

                if (data.success) {
                    badgeBtn.className = 'badge-clickable badge ' + data.badgeClass;
                    labelSpan.textContent = data.label;

                    dropdown.querySelectorAll('.status-action-item').forEach(function(btn) {
                        btn.classList.remove('is-active');
                        var check = btn.querySelector('.status-check');
                        if (check) check.remove();
                    });
                    itemBtn.classList.add('is-active');
                    var checkSpan = document.createElement('span');
                    checkSpan.className = 'status-check';
                    checkSpan.textContent = '✓';
                    itemBtn.appendChild(checkSpan);

                    window.closeAdminDropdownMenus();
                    showToast(data.message || 'Le statut a été mis à jour.', data.emailSent === false ? 'error' : 'success');
                } else {
                    badgeBtn.style.opacity = '1';
                    badgeBtn.style.pointerEvents = '';
                    labelSpan.textContent = oldText;
                    showToast(data.message || 'Impossible de mettre à jour le statut.', 'error');
                }
            })
            .catch(function(error) {
                badgeBtn.style.opacity = '1';
                badgeBtn.style.pointerEvents = '';
                labelSpan.textContent = oldText;
                showToast(error.message || 'Erreur réseau ou permission insuffisante.', 'error');
            });
        }

        // ── Gestion de la Modale de Suppression ──
        function openDeleteModal(id, clientName, excursionTitle, deleteUrl, csrfToken) {
            window.closeAdminDropdownMenus();
            document.getElementById('modalClientName').textContent = clientName || 'Client';
            document.getElementById('modalExcursionTitle').textContent = excursionTitle || 'Excursion';
            document.getElementById('modalReservationId').textContent = '#' + id;
            document.getElementById('deleteForm').action = deleteUrl;
            document.getElementById('deleteCsrfToken').value = csrfToken;
            document.getElementById('deleteModalOverlay').classList.add('open');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModalOverlay').classList.remove('open');
        }

        document.getElementById('deleteModalOverlay').addEventListener('click', function(e) {
            if (e.target === this) {
                closeDeleteModal();
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && document.getElementById('deleteModalOverlay').classList.contains('open')) {
                closeDeleteModal();
            }
        });

        // ── Toast Notifications ──
        function showToast(message, type) {
            var toast = document.getElementById('admin-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'admin-toast';
                document.body.appendChild(toast);
            }
            toast.textContent = message;
            toast.className = 'admin-toast admin-toast-' + (type || 'success') + ' show';
            clearTimeout(toast.timeoutId);
            toast.timeoutId = setTimeout(function() {
                toast.classList.remove('show');
            }, 3500);
        }
    </script>
{% endblock %}
