{% extends 'Backend/base.html.twig' %}

{% block title %}{{ title }} - Admin{% endblock %}

{% block header_title %}{{ title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assetsBack/css/transfere/form.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">{{ title }}</h1>
        <p class="page-header-description">Configurez les détails et traductions du transfert.</p>
    </div>
    <div class="page-actions">
        <a href="{{ path('admin_transfere_index') }}" class="btn btn-secondary">Retour</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form) }}
        {{ form_errors(form) }}
        
        <div class="form-section">
            <h2 class="form-section-title">Informations générales</h2>
            
            <div class="form-row form-row-3">
                <div class="form-group">
                    {{ form_label(form.prixNormal) }}
                    {{ form_widget(form.prixNormal, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.prixNormal) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.prixSaisonForte) }}
                    {{ form_widget(form.prixSaisonForte, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.prixSaisonForte) }}
                </div>
                <div class="form-group">
                    <div class="form-check" style="margin-top: 1.5rem;">
                        {{ form_widget(form.actif, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.actif, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                </div>
            </div>
            
            <div class="form-group" style="margin-bottom: 1.5rem;">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'accept': 'image/jpeg, image/png, image/webp', 'onchange': 'previewImage(event)'}}) }}
                {{ form_errors(form.imageFile) }}
                
                <div class="mt-2" style="margin-top: 10px;">
                    <img id="imagePreview" src="{{ form.vars.value.image ? asset(form.vars.value.image) : '' }}" style="max-width: 200px; display: {{ form.vars.value.image ? 'block' : 'none' }}; border-radius: 8px;" alt="Aperçu de l'image">
                </div>
                
                <script>
                    function previewImage(event) {
                        const file = event.target.files[0];
                        const preview = document.getElementById('imagePreview');
                        if (file) {
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                preview.src = e.target.result;
                                preview.style.display = 'block';
                            }
                            reader.readAsDataURL(file);
                        } else {
                            preview.src = '';
                            preview.style.display = 'none';
                        }
                    }
                </script>
            </div>

            {% if form.description is defined %}
                <div class="form-group">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.description) }}
                </div>
            {% endif %}
        </div>
        
        <div class="form-section">
            <h2 class="form-section-title">Traductions</h2>
            <p class="form-section-description">Les lieux français sont obligatoires. Les autres langues utilisent le français en cas de traduction manquante.</p>
            
            <div class="form-row form-row-3">
                {% for translationForm in form.translations %}
                    {% set locale = translationForm.vars.data.locale %}
                    {% if locale in ['fr', 'en'] %}
                    <div class="form-group">
                        <div class="translation-card">
                            <div class="translation-card-header">
                                <h3 class="translation-card-title">{{ localeLabels[locale] }}</h3>
                            </div>
                            <div class="translation-card-body">
                                {{ form_errors(translationForm) }}
                                <div class="form-group">
                                    {{ form_label(translationForm.lieuDepart) }}
                                    {{ form_widget(translationForm.lieuDepart, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(translationForm.lieuDepart) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(translationForm.lieuArrivee) }}
                                    {{ form_widget(translationForm.lieuArrivee, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(translationForm.lieuArrivee) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(translationForm.duree) }}
                                    {{ form_widget(translationForm.duree, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(translationForm.duree) }}
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        
        <div class="form-actions">
            <a href="{{ path('admin_transfere_index') }}" class="btn btn-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
        
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}