{% extends 'Backend/base.html.twig' %}

{% block title %}Modifier la réservation - Admin{% endblock %}

{% block header_title %}Modifier le statut de la réservation{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">Modifier la réservation #{{ reservation.id }}</h1>
        <p class="page-header-description">Client : {{ reservation.nom }} {{ reservation.prenom }} ({{ reservation.email }})</p>
    </div>
    <div class="page-actions">
        <a href="{{ path('admin_reservation_index', redirectParams|default({})) }}" class="btn btn-secondary">Retour</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('edit' ~ reservation.id) }}">
            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label for="status" class="form-label" style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Statut de la réservation</label>
                <select id="status" name="status" class="form-control" required style="max-width: 300px;">
                    <option value="pending" {% if reservation.status.value == 'pending' %}selected{% endif %}>En attente</option>
                    <option value="confirmed" {% if reservation.status.value == 'confirmed' %}selected{% endif %}>Confirmée</option>
                    <option value="cancelled" {% if reservation.status.value == 'cancelled' %}selected{% endif %}>Annulée</option>
                </select>
            </div>
            
            <div class="form-actions" style="display: flex; gap: 0.75rem;">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('admin_reservation_index', redirectParams|default({})) }}" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
