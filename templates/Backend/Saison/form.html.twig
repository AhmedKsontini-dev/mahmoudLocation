{% extends 'Backend/base.html.twig' %}

{% block title %}{{ title }} - Admin{% endblock %}

{% block header_title %}{{ title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assetsBack/css/saison/form.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">{{ title }}</h1>
        <p class="page-header-description">Configurez les détails de la saison et sa période.</p>
    </div>
    <div class="page-actions">
        <a href="{{ path('admin_saison_index') }}" class="btn btn-secondary">Retour</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form) }}
        
        <div class="form-section">
            <h2 class="form-section-title">Informations générales</h2>
            
            <div class="form-group">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.nom) }}
            </div>
        </div>
        
        <div class="form-section">
            <h2 class="form-section-title">Période (récurrente chaque année)</h2>
            <p class="page-header-description">Choisissez uniquement le jour et le mois : la saison se répète automatiquement chaque année, sans année à saisir.</p>

            <div class="form-group">
                <label class="form-check-label">Début de la saison forte</label>
                <div class="form-row form-row-2">
                    <div class="form-group">
                        {{ form_label(form.dateDebutJour) }}
                        {{ form_widget(form.dateDebutJour, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateDebutJour) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.dateDebutMois) }}
                        {{ form_widget(form.dateDebutMois, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateDebutMois) }}
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-check-label">Fin de la saison forte</label>
                <div class="form-row form-row-2">
                    <div class="form-group">
                        {{ form_label(form.dateFinJour) }}
                        {{ form_widget(form.dateFinJour, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateFinJour) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.dateFinMois) }}
                        {{ form_widget(form.dateFinMois, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateFinMois) }}
                    </div>
                </div>
            </div>

            <div class="form-group">
                {{ form_errors(form) }}
            </div>
        </div>
        
        <div class="form-section">
            <h2 class="form-section-title">Statut</h2>
            
            <div class="form-group">
                <div class="form-check">
                    {{ form_widget(form.actif, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(form.actif, null, {'label_attr': {'class': 'form-check-label'}}) }}
                </div>
            </div>
        </div>
        
        <div class="form-actions">
            <a href="{{ path('admin_saison_index') }}" class="btn btn-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
        
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
